// modules_page is where the registry was: it is part of the Applications page now.
fn modules_page(req: Request) Response {
    return redirect("/applications#registry")
}

// registry_section is the orchestrator's registry, for the Applications page.
fn registry_section(req: Request) string {
    return template_fill(template_get("modules"), vars("rows", module_rows(req)) + i18n_vars(req))
}

fn module_page(req: Request) Response {
    let name: string = param(req, "name")
    let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
    if !valid_name(name) || !rho_path_exists(entry) {
        return page_status(req, status_not_found(), i18n_t(req, "page.not_found"), "<p>" + escape_html(keeper_t1(req, "registry.unknown", "name", name)) + "</p><p><a href='/modules'>" + i18n_t(req, "common.back") + "</a></p>")
    }
    let role: string = yaml.value(entry, "role")
    let path: string = resolve_path(yaml.value(entry, "path"))
    let git: string = yaml.value(entry, "git")
    let summary: string = yaml.value(entry, "summary")
    let installed: string = i18n_t(req, "common.no")
    let version: string = ""
    if rho_path_exists(path + "/module.yml") {
        installed = i18n_t(req, "common.yes")
        version = yaml.value(path + "/module.yml", "module.version")
    }
    let info: string = template_fill(template_get("module-detail"), vars("name", name) + vars("version", version) + vars("role", role) + vars("path", path) + vars("git", git) + vars("summary", summary) + vars("installed", installed) + vars("docs_link", "<a href='/docs/" + name + "'>" + i18n_t(req, "common.documentation") + "</a>") + i18n_vars(req))
    return page(req, name, info)
}

// registry_entry is the orchestrator's registry file for a module a form named,
// or "" when the name is not a plain module name or names nothing.
fn registry_entry(name: string) string {
    if !valid_name(name) {
        return ""
    }
    let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
    if !rho_path_exists(entry) {
        return ""
    }
    return entry
}

fn registry_back(req: Request, status: u32, title: string, message: string) Response {
    return page_status(req, status, title, "<p>" + escape_html(message) + "</p><p><a href='/modules'>" + i18n_t(req, "common.back") + "</a></p>")
}

// The checkouts the keeper fetched itself, one path per line. Only these are
// ever removed: a checkout somebody made by hand is theirs, with whatever work
// is in it.
fn fetched_file() string {
    return keeper_state_dir() + "/fetched.txt"
}

fn fetched_by_keeper(path: string) bool {
    return rho_str_index_of("\n" + rho_read_text(fetched_file()), "\n" + path + "\n") >= 0
}

fn fetched_set(path: string, keep: bool) void {
    var out: string = ""
    var rest: string = rho_read_text(fetched_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" && !rho_str_eq(line, path) {
            out = out + line + "\n"
        }
    }
    if keep {
        out = out + path + "\n"
    }
    ignore_bool(rho_write_text(fetched_file(), out))
}

fn install_page(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let title: string = i18n_t(req, "page.install")
    let name: string = str_trim(form_field(request_body(req), "module"))
    let entry: string = registry_entry(name)
    if entry == "" {
        return registry_back(req, status_not_found(), title, keeper_t1(req, "registry.unknown", "name", name))
    }
    let git_url: string = yaml.value(entry, "git")
    let path: string = resolve_path(yaml.value(entry, "path"))
    if rho_path_exists(path + "/module.yml") {
        return registry_back(req, status_ok(), title, keeper_t1(req, "registry.already_installed", "name", name))
    }
    if !arg_ok(git_url) || !arg_ok(path) {
        return registry_back(req, status_bad_request(), title, keeper_t1(req, "registry.bad_entry", "name", name))
    }
    ensure_keeper_state()
    let output: string = apps_report("clone-" + name)
    let code: u32 = rho_exec_args("git", "clone\n--\n" + git_url + "\n" + path + "\n", output)
    if code != 0 {
        return registry_back(req, status_internal(), title, keeper_t1(req, "registry.clone_failed", "name", name))
    }
    fetched_set(path, true)
    info("keeper", "fetched " + name + " into " + path)
    return registry_back(req, status_created(), title, keeper_t1(req, "registry.installed_msg", "name", name))
}

fn uninstall_page(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let title: string = i18n_t(req, "page.uninstall")
    let name: string = str_trim(form_field(request_body(req), "module"))
    let entry: string = registry_entry(name)
    if entry == "" {
        return registry_back(req, status_not_found(), title, keeper_t1(req, "registry.unknown", "name", name))
    }
    let path: string = resolve_path(yaml.value(entry, "path"))
    if !rho_path_exists(path + "/module.yml") {
        return registry_back(req, status_ok(), title, keeper_t1(req, "registry.not_installed", "name", name))
    }
    if !fetched_by_keeper(path) {
        return registry_back(req, status_conflict(), title, keeper_t2(req, "registry.not_fetched", "name", name, "path", path))
    }
    let output: string = apps_report("uninstall-" + name)
    let code: u32 = rho_exec_args("rm", "-rf\n--\n" + path + "\n", output)
    if code != 0 {
        return registry_back(req, status_internal(), title, keeper_t1(req, "registry.uninstall_failed", "name", name))
    }
    fetched_set(path, false)
    info("keeper", "removed " + name + " from " + path)
    return registry_back(req, status_ok(), title, keeper_t1(req, "registry.uninstalled", "name", name))
}

fn docs_page(req: Request) Response {
    let rows: string = docs_rows()
    let body: string = template_fill(template_get("docs"), vars("rows", rows) + i18n_vars(req))
    return page(req, i18n_t(req, "page.docs"), body)
}

fn doc_page(req: Request) Response {
    let path: string = param(req, "path")
    // A page is a name under the docs tree: never a way out of it.
    if rho_str_index_of(path, "..") >= 0 || rho_str_starts_with(path, "/") || rho_str_index_of(path, "\\") >= 0 {
        return page_status(req, status_not_found(), i18n_t(req, "page.not_found"), "<p><a href='/docs'>" + i18n_t(req, "common.all_docs") + "</a></p>")
    }
    // The path from the URL may or may not have the docs/ prefix.
    var full_path: string = path
    if rho_str_index_of(path, "docs/") != 0 {
        full_path = "docs/" + path
    }
    // The page is the one the generator wrote, so a page served here and a page
    // a build writes are the same page.
    let content: string = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + full_path + ".md")
    if content == "" {
        content = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + full_path + "/index.md")
    }
    if content == "" {
        content = docs_render_source(DOCS_TREE + "/" + full_path + "/docs/index.md")
    }
    if content == "" {
        content = docs_render_source(robohub_root() + "/" + DOCS_TREE + "/" + path + "/docs/index.md")
    }
    if content == "" {
        return page_status(req, status_not_found(), i18n_t(req, "page.not_found"), "<p>" + escape_html(keeper_t1(req, "docs.not_built", "path", path)) + "</p><p><a href='/docs'>" + i18n_t(req, "common.all_docs") + "</a></p>")
    }
    return page(req, path, content)
}

fn docs_rows() string {
    // The pages the store holds: path, title and section, one per line.
    let listing: string = docs_list(robohub_root() + "/" + DOCS_TREE)
    var result: string = ""
    var rest: string = listing
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        // path<TAB>title<TAB>section
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let path: string = rho_str_slice(line, 0, u32(tab))
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        var title: string = tail
        if tab2 >= 0 {
            title = rho_str_slice(tail, 0, u32(tab2))
        }
        // The link is the path without its extension and without the docs/
        // prefix: the store lists paths relative to the tree root, which
        // includes the docs/ directory, but the keeper serves them from /docs/.
        // Strip the docs/ directory from the path: the store lists paths
        // relative to the tree root, which includes docs/ as a directory, but
        // the keeper serves them from /docs/.
        // The store lists paths relative to the tree root, which includes
        // docs/ as a directory. Strip the docs/ segment, keeping what is
        // before and after it.
        let link: string = path
        // Strip docs/ from the beginning (orchestrator's own docs)
        if rho_str_index_of(link, "docs/") == 0 {
            link = rho_str_slice(link, 5, u32(rho_strlen(link)) - 5)
        } else {
            // Strip /docs/ from the middle (module docs)
            let docs_pos: i32 = rho_str_index_of(link, "/docs/")
            if docs_pos >= 0 {
                let before: string = rho_str_slice(link, 0, u32(docs_pos))
                let after: string = rho_str_slice(link, u32(docs_pos) + 6, u32(rho_strlen(link)) - u32(docs_pos) - 6)
                if before == "" {
                    link = after
                } else {
                    link = before + "/" + after
                }
            }
        }
        if rho_str_index_of(link, ".md") >= 0 {
            link = rho_str_slice(link, 0, u32(rho_str_index_of(link, ".md")))
        }
        let link_name: string = link
        let slash: i32 = rho_str_index_of(link_name, "/")
        if slash >= 0 {
            link_name = rho_str_slice(link_name, 0, u32(slash))
        }
        result = result + "<tr><td><a href='/docs/" + escape_html(link_name) + "'>" + escape_html(title) + "</a></td><td>" + escape_html(path) + "</td></tr>"
    }
    return result
}

// resolve_path turns a module's path into one that does not depend on where the
// keeper was started from. A path that is already absolute is taken as written;
// a relative path is taken relative to the workspace root.
// robohub_root is where the orchestrator lives. It is said by the
// environment, because a path into another repository belongs to the machine.
fn robohub_root() string {
    // The workspace is said by the environment, because a path into another
    // repository belongs to the machine, and a machine that says nothing has
    // the orchestrator where the keeper was started.
    let root: string = getenv("ROBOHUB_ROOT")
    if root == "" {
        // ROBOHUB_WORKSPACE is the directory that holds the ecosystem's
        // repositories, the orchestrator among them.
        let workspace: string = getenv("ROBOHUB_WORKSPACE")
        if workspace != "" && rho_path_exists(workspace + "/robohub/registry/modules") {
            return workspace + "/robohub"
        }
        if rho_path_exists("registry/modules") {
            return "."
        }
        warn("keeper", "set ROBOHUB_ROOT to the orchestrator directory")
        return "."
    }
    if rho_path_exists(root + "/robohub/registry/modules") {
        return root + "/robohub"
    }
    if rho_path_exists(root + "/registry/modules") {
        return root
    }
    return root + "/robohub"
}

fn resolve_path(path: string) string {
    if rho_str_index_of(path, "/") == 0 {
        return path
    }
    let root: string = robohub_root()
    return root + "/" + path
}

fn module_rows(req: Request) string {
    // Discover modules from the registry directory
    let listing: string = ""
    let reg_dir: string = robohub_root() + "/registry/modules"
    let code: u32 = rho_exec_args("ls", reg_dir + "\n", "build/reports/ls-modules.txt")
    if code == 0 {
        listing = rho_read_text("build/reports/ls-modules.txt")
    }
    var result: string = ""
    var rest: string = listing
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let filename: string = ""
        if at < 0 {
            filename = rest
            rest = ""
        } else {
            filename = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if filename == "" {
            continue
        }
        // Extract module name from filename (remove .yml extension)
        if rho_str_index_of(filename, ".yml") < 0 {
            continue
        }
        let name: string = rho_str_slice(filename, 0, u32(rho_str_index_of(filename, ".yml")))
        let entry: string = robohub_root() + "/registry/modules/" + name + ".yml"
        let role: string = yaml.value(entry, "role")
        let path: string = resolve_path(yaml.value(entry, "path"))
        let installed: string = i18n_t(req, "common.no")
        let version: string = ""
        var badge: string = "<form method='post' action='/install'><input type='hidden' name='module' value='" + name + "'><button type='submit'>" + i18n_t(req, "common.install") + "</button></form>"
        if !valid_name(name) {
            continue
        }
        if rho_path_exists(path + "/module.yml") {
            installed = i18n_t(req, "common.yes")
            version = yaml.value(path + "/module.yml", "module.version")
            badge = ""
            if fetched_by_keeper(path) {
                badge = "<form method='post' action='/uninstall' onsubmit=\"" + keeper_confirm(req, "registry.uninstall_confirm") + "\"><input type='hidden' name='module' value='" + name + "'><button type='submit' class='danger'>" + i18n_t(req, "common.uninstall") + "</button></form>"
            }
        }
        let row: string = template_fill(template_get("module-row"), vars("name", name) + vars("role", role) + vars("version", version) + vars("installed", installed) + vars("badge", badge) + i18n_vars(req))
        result = result + row
    }
    return result
}
