/// The documentation tree the site is built from.
const DOCS_TREE: string = "build/doctree"

/// Where the built site is, which is what a page is served from when the store
/// has not built one of its own.
const DOCS_SITE: string = "build/site"

fn init() void {
    log_config_apply("keeper")
    info("keeper", "starting")
}

