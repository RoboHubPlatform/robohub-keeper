module keeper.nodes

// Enrolled node identities: the record Keeper issued, and the actions an
// operator can take on it. A credential is checked by /api/nodes/verify; the
// gateway/firmware side is what must call that for every node frame.

fn node_dir() string {
    return keeper_state_dir() + "/nodes"
}

fn node_path(device: string) string {
    return node_dir() + "/" + device + ".txt"
}

fn node_record(device: string) string {
    if !valid_name(device) {
        return ""
    }
    let path: string = node_path(device)
    if !rho_path_exists(path) {
        return ""
    }
    return rho_read_text(path)
}

fn node_status(req: Request, device: string) string {
    if rho_path_exists(node_path(device)) {
        return template_fill(template_get("status"),
            vars("tone", "running") + vars("label", i18n_t(req, "nodes.enrolled")))
    }
    return template_fill(template_get("status"),
        vars("tone", "not-built") + vars("label", i18n_t(req, "nodes.revoked_state")))
}

fn node_rows(req: Request) string {
    let report: string = apps_report("node-list")
    ignore_u32(rho_exec_args("ls", node_dir() + "\n", report))
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var file: string = rest
        if at < 0 { rest = "" } else {
            file = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if file == "" || rho_str_index_of(file, ".txt") < 0 {
            continue
        }
        let device: string = rho_str_slice(file, 0, u32(rho_strlen(file)) - 4)
        let record: string = node_record(device)
        if record == "" {
            continue
        }
        out = out + template_fill(template_get("node-row"),
            vars("device", device) +
            vars("project", field(record, 2)) +
            vars("area", field(record, 3)) +
            vars("node", field(record, 4)) +
            vars("created", field(record, 6)) +
            vars("status", node_status(req, device)) + i18n_vars(req) + vars("csrf", forms_csrf_field()) +
            vars("revoke_confirm", json_string(keeper_t1(req, "nodes.revoke_confirm", "device", device))))
    }
    if out == "" {
        out = "<tr><td colspan=\"6\">" + i18n_t(req, "nodes.none") + "</td></tr>"
    }
    return out
}

fn keeper_nodes_page_message(req: Request, message: string) Response {
    var notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"),
            vars("message", message))
    }
    let body: string = template_fill(template_get("nodes"),
        i18n_vars(req) + vars("notice", notice) + vars("rows", node_rows(req)))
    return page(req, i18n_t(req, "page.nodes"), body)
}

fn keeper_nodes_page(req: Request) Response {
    return keeper_nodes_page_message(req, "")
}

// @req KEEP-ENROLL-0008, KEEP-AUTH-0014
fn keeper_nodes_revoke(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return keeper_csrf_refused(req)
    }
    let device: string = str_trim(form_field(body, "device"))
    if node_record(device) == "" {
        return keeper_nodes_page_message(req, i18n_t(req, "nodes.not_enrolled"))
    }
    ignore_u32(rho_exec_args("rm", "-f\n" + node_path(device) + "\n", apps_report("node-revoke")))
    info("keeper", "revoked node " + device)
    keeper_event("node.revoked", "", "Node " + device + " was revoked; its credential no longer verifies.")
    return keeper_nodes_page_message(req, keeper_t1(req, "nodes.revoked", "device", device))
}

// @req KEEP-ENROLL-0008, KEEP-AUTH-0014
fn keeper_nodes_rotate(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return keeper_csrf_refused(req)
    }
    let device: string = str_trim(form_field(body, "device"))
    let record: string = node_record(device)
    if record == "" {
        return keeper_nodes_page_message(req, i18n_t(req, "nodes.not_enrolled"))
    }
    let credential: string = rho_random_hex(32)
    let stored: string = credential_hash(rho_random_hex(16), credential)
    if rho_strlen(credential) != 64 || stored == "" {
        return keeper_nodes_page_message(req, i18n_t(req, "nodes.credential_failed"))
    }
    ignore_bool(rho_write_secret(node_path(device), node_record_with(record, stored)))
    info("keeper", "rotated credential for node " + device)
    keeper_event("node.rotated", "", "The credential of node " + device + " was rotated.")
    return keeper_nodes_page_message(req, keeper_t2(req, "nodes.new_credential", "device", device, "credential", credential))
}

// node_record_with is a node record with another stored credential.
fn node_record_with(record: string, stored: string) string {
    return field(record, 0) + "|" + field(record, 1) + "|" + field(record, 2) +
        "|" + field(record, 3) + "|" + field(record, 4) + "|" + stored +
        "|" + str_trim(field(record, 6)) + "\n"
}

// node_store_hashed rewrites a record whose credential is kept as it was issued
// (before credentials were hashed) with the salted hash of it. It reports
// whether the record now holds a hash.
fn node_store_hashed(device: string, record: string) bool {
    let stored: string = field(record, 5)
    if credential_hashed(stored) {
        return true
    }
    let hashed: string = credential_hash(rho_random_hex(16), stored)
    if hashed == "" {
        return false
    }
    return rho_write_secret(node_path(device), node_record_with(record, hashed))
}

// keeper_nodes_migrate hashes every node credential still kept in the clear;
// the keeper runs it when it starts.
// @req KEEP-ENROLL-0005
fn keeper_nodes_migrate() void {
    let report: string = apps_report("node-migrate")
    if !rho_path_exists(node_dir()) {
        return
    }
    ignore_u32(rho_exec_args("chmod", "700\n" + node_dir() + "\n", report))
    ignore_u32(rho_exec_args("ls", node_dir() + "\n", report))
    var rest: string = rho_read_text(report)
    var migrated: u32 = 0
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var file: string = rest
        if at < 0 { rest = "" } else {
            file = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let length: u32 = u32(rho_strlen(file))
        if length <= 4 || !rho_str_eq(rho_str_slice(file, length - 4, 4), ".txt") {
            continue
        }
        let device: string = rho_str_slice(file, 0, length - 4)
        let record: string = node_record(device)
        if record != "" && !credential_hashed(field(record, 5)) && node_store_hashed(device, record) {
            migrated = migrated + 1
        }
    }
    if migrated > 0 {
        info("keeper", "hashed " + rho_int_to_str(migrated) + " node credential(s) kept in the clear")
    }
}

// keeper_node_verify is the contract a gateway, Mesh or firmware calls before it
// accepts a node. It is authenticated by the credential itself, and a client
// has a budget of calls, so it is not a way to guess one.
// @req KEEP-ENROLL-0007
fn keeper_node_verify(req: Request) Response {
    if !rate_take(req, "verify", VERIFY_PER_CLIENT, VERIFY_PER_WINDOW) {
        return rate_refused()
    }
    let body: string = request_body(req)
    let device: string = str_trim(form_field(body, "device_id"))
    let credential: string = str_trim(form_field(body, "credential"))
    let record: string = node_record(device)
    if record == "" || !credential_matches(field(record, 5), credential) {
        return Response{ 403, "{\"ok\":false,\"error\":\"unknown node or credential\"}", "application/json", "" }
    }
    // A record from before hashing is hashed the first time it is used.
    if !credential_hashed(field(record, 5)) {
        ignore_bool(node_store_hashed(device, record))
    }
    return Response{ 200,
        "{\"ok\":true,\"device_id\":" + json_string(device) +
        ",\"project\":" + json_string(field(record, 2)) +
        ",\"area\":" + rho_int_to_str(rho_int_from_str(field(record, 3))) +
        ",\"node\":" + rho_int_to_str(rho_int_from_str(field(record, 4))) + "}",
        "application/json", "" }
}
