module keeper.enrollment

// One-time enrollment: a token is placed on the keeper host before a node
// boots; the node exchanges it, with its locally generated public key, for a
// credential. The token is used once and the node record is kept for revoke.

fn enrollment_tokens_file() string {
    return keeper_state_dir() + "/enrollment.tokens"
}

fn enrollment_nodes_dir() string {
    return keeper_state_dir() + "/nodes"
}

fn enrollment_now() u32 {
    return rho_now_s()
}

// The token file is shared with `rho bootstrap token`, another process, which
// adds lines to it while the keeper marks them used. Both take the same lock — a
// directory beside the file, made with mkdir, which either makes it or finds it
// there — and both replace the file whole through a temporary file and a rename,
// so a reader never sees half of it and a line added during a mark is not lost.
const ENROLL_LOCK_TRIES: u32 = 50
const ENROLL_LOCK_WAIT_MS: u32 = 100

extern fn rho_sleep_ms(ms: u32)

fn enrollment_lock_dir() string {
    return enrollment_tokens_file() + ".lock"
}

// enrollment_lock takes the token file's lock, for this process's requests and
// for other processes. A lock that is still held after the tries is taken as
// left behind by a process that died holding it.
fn enrollment_lock() void {
    rho_lock("keeper.enrollment")
    let report: string = apps_report("enrollment-lock")
    ignore_u32(rho_exec_args("mkdir", "-p\n" + keeper_state_dir() + "\n", report))
    var tries: u32 = 0
    while tries < ENROLL_LOCK_TRIES {
        if rho_exec_args("mkdir", enrollment_lock_dir() + "\n", report) == 0 {
            return
        }
        rho_sleep_ms(ENROLL_LOCK_WAIT_MS)
        tries = tries + 1
    }
    warn("keeper", "the enrollment lock was held too long; taking it")
    ignore_u32(rho_exec_args("rm", "-rf\n" + enrollment_lock_dir() + "\n", report))
    ignore_u32(rho_exec_args("mkdir", enrollment_lock_dir() + "\n", report))
}

fn enrollment_unlock() void {
    ignore_u32(rho_exec_args("rmdir", enrollment_lock_dir() + "\n", apps_report("enrollment-lock")))
    rho_unlock("keeper.enrollment")
}

fn enrollment_find_token(token: string) string {
    var rest: string = rho_read_text(enrollment_tokens_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if token != "" && secret_same(field(line, 0), token) {
            return line
        }
    }
    return ""
}

// enrollment_mark_used marks a token spent; the caller holds the lock.
fn enrollment_mark_used(token: string) bool {
    var out: string = ""
    var rest: string = rho_read_text(enrollment_tokens_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" { continue }
        if rho_str_eq(field(line, 0), token) {
            line = enrollment_mark_line(line)
        }
        out = out + line + "\n"
    }
    return rho_write_secret(enrollment_tokens_file(), out)
}

// record_field_ok is whether a value can be one field of a node record: no field
// separator and no line break.
fn record_field_ok(value: string) bool {
    return rho_str_index_of(value, "|") < 0 && rho_str_index_of(value, "\n") < 0 &&
        rho_str_index_of(value, "\r") < 0 && rho_strlen(value) <= 4096
}

// enrollment_number is a node's area or number: digits, one to five of them.
fn enrollment_number(text: string) bool {
    return enrollment_digits(text)
}

fn enrollment_refused(status: u32, error: string) Response {
    return Response{ status, "{\"ok\":false,\"error\":" + json_string(error) + "}", "application/json", "" }
}

/* -------------------------------------------------------------------------- */
/*  The request budget                                                        */
/* -------------------------------------------------------------------------- */

fn rate_dir() string {
    return keeper_state_dir() + "/rate"
}


// rate_peer is who a request is counted against: the address of the connection
// itself, which a caller cannot write. Only when that is this machine — a TLS
// proxy or an SSH tunnel in front of the keeper — is the proxy's forwarded
// address used instead, because then the proxy wrote it.
// @req KEEP-ENROLL-0006
fn rate_peer(req: Request) string {
    let peer: string = request_remote(req)
    if peer != "" && peer != "127.0.0.1" && peer != "::1" {
        return peer
    }
    return rate_client(header_str(req, "X-Forwarded-For"), header_str(req, "X-Real-Ip"))
}

// rate_take counts one call of a request against its client's budget and the
// budget of every client together; false when either is spent.
// @req KEEP-ENROLL-0006
fn rate_take(req: Request, bucket: string, per_client: u32, per_window: u32) bool {
    let client: string = rate_peer(req)
    rho_lock("keeper.rate")
    ignore_u32(rho_exec_args("mkdir", "-p\n" + rate_dir() + "\n", apps_report("rate-mkdir")))
    let now: u32 = enrollment_now()
    let own_file: string = rate_dir() + "/" + bucket + "-" + rate_slot(client)
    let all_file: string = rate_dir() + "/" + bucket + "-all"
    let own: string = rate_next(str_trim(rho_read_text(own_file)), now, RATE_WINDOW_SECONDS)
    let all: string = rate_next(str_trim(rho_read_text(all_file)), now, RATE_WINDOW_SECONDS)
    ignore_bool(rho_write_text(own_file, own + "\n"))
    ignore_bool(rho_write_text(all_file, all + "\n"))
    rho_unlock("keeper.rate")
    return !rate_over(own, per_client) && !rate_over(all, per_window)
}

fn rate_refused() Response {
    return Response{ 429, "{\"ok\":false,\"error\":\"too many requests\"}", "application/json",
        "Retry-After: " + rho_int_to_str(RATE_WINDOW_SECONDS) }
}

// @req KEEP-ENROLL-0001, KEEP-ENROLL-0002, KEEP-ENROLL-0003, KEEP-ENROLL-0004, KEEP-ENROLL-0005
fn keeper_enroll(req: Request) Response {
    if !rate_take(req, "enroll", ENROLL_PER_CLIENT, ENROLL_PER_WINDOW) {
        return rate_refused()
    }
    let body: string = request_body(req)
    let token: string = str_trim(form_field(body, "token"))
    let device: string = str_trim(form_field(body, "device_id"))
    let public: string = str_trim(form_field(body, "public_key"))
    let project: string = str_trim(form_field(body, "project"))
    let area: string = str_trim(form_field(body, "area"))
    let node: string = str_trim(form_field(body, "node"))
    if token == "" || device == "" || public == "" {
        return enrollment_refused(400, "missing enrollment fields")
    }
    // The device names the file its record is kept in, and every field is one
    // field of a `|`-separated line: neither may say more than it is. The
    // placement a request names is only compared with its token's.
    if !valid_name(device) || !record_field_ok(public) || !record_field_ok(project) ||
        (area != "" && !enrollment_number(area)) || (node != "" && !enrollment_number(node)) {
        return enrollment_refused(400, "malformed enrollment fields")
    }
    let path: string = enrollment_nodes_dir() + "/" + device + ".txt"
    // Finding the token, checking it, writing the node and spending the token
    // are one step: two requests with one token cannot both enroll.
    enrollment_lock()
    let line: string = enrollment_find_token(token)
    let problem: string = enrollment_token_problem(line, device, enrollment_now())
    if problem != "" {
        enrollment_unlock()
        info("keeper", "enrollment refused for " + device + ": " + problem)
        if rho_str_eq(problem, "enrollment token already used") {
            return enrollment_refused(409, problem)
        }
        return enrollment_refused(403, problem)
    }
    if enrollment_placement_differs(line, project, area, node) {
        enrollment_unlock()
        info("keeper", "enrollment refused for " + device + ": its placement is not its token's")
        return enrollment_refused(403, "the requested placement is not the token's")
    }
    // A device already enrolled is replaced only by a token made to re-enroll
    // it; otherwise its credential is changed only by rotating it.
    if rho_path_exists(path) && !enrollment_token_reenroll(line) {
        enrollment_unlock()
        return enrollment_refused(409, "that device is already enrolled")
    }
    let credential: string = rho_random_hex(32)
    let salt: string = rho_random_hex(16)
    let stored: string = credential_hash(salt, credential)
    if rho_strlen(credential) != 64 || rho_strlen(salt) != 32 || stored == "" {
        enrollment_unlock()
        return enrollment_refused(500, "credential generation failed")
    }
    let record: string = device + "|" + public + "|" + field(line, 2) + "|" +
        rho_int_to_str(rho_int_from_str(field(line, 3))) + "|" + rho_int_to_str(rho_int_from_str(field(line, 4))) +
        "|" + stored + "|" + rho_int_to_str(enrollment_now()) + "\n"
    ignore_u32(rho_exec_args("mkdir", "-p\n" + enrollment_nodes_dir() + "\n", apps_report("enrollment-mkdir")))
    ignore_u32(rho_exec_args("chmod", "700\n" + enrollment_nodes_dir() + "\n", apps_report("enrollment-chmod")))
    if !enrollment_mark_used(field(line, 0)) {
        enrollment_unlock()
        return enrollment_refused(500, "the token could not be spent")
    }
    if !rho_write_secret(path, record) {
        enrollment_unlock()
        return enrollment_refused(500, "the node record could not be written")
    }
    enrollment_unlock()
    info("keeper", "enrolled node " + device)
    return Response{ 200, "{\"ok\":true,\"credential\":" + json_string(credential) +
        ",\"project\":" + json_string(field(line, 2)) +
        ",\"area\":" + rho_int_to_str(rho_int_from_str(field(line, 3))) +
        ",\"node\":" + rho_int_to_str(rho_int_from_str(field(line, 4))) + "}",
        "application/json", "" }
}
