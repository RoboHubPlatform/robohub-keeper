module keeper.enrollment

// One-time enrollment: a token is placed on the keeper host before a node
// boots; the node exchanges it, with its locally generated public key, for a
// credential. The token is used once and the node record is kept for revoke.

fn enrollment_tokens_file() string {
    return keeper_state_dir() + "/enrollment.tokens"
}

fn enrollment_nodes_dir() string {
    return keeper_state_dir() + "/nodes"
}

fn enrollment_now() u32 {
    return rho_now_s()
}

fn enrollment_find_token(token: string) string {
    var rest: string = rho_read_text(enrollment_tokens_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if field(line, 0) == token {
            return line
        }
    }
    return ""
}

fn enrollment_mark_used(token: string) void {
    var out: string = ""
    var rest: string = rho_read_text(enrollment_tokens_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" { continue }
        if field(line, 0) == token {
            line = line + "|used"
        }
        out = out + line + "\n"
    }
    ignore_bool(rho_write_secret(enrollment_tokens_file(), out))
}

// record_field_ok is whether a value can be one field of a node record: no field
// separator and no line break.
fn record_field_ok(value: string) bool {
    return rho_str_index_of(value, "|") < 0 && rho_str_index_of(value, "\n") < 0 &&
        rho_str_index_of(value, "\r") < 0 && rho_strlen(value) <= 4096
}

fn keeper_enroll(req: Request) Response {
    let body: string = request_body(req)
    let token: string = str_trim(form_field(body, "token"))
    let device: string = str_trim(form_field(body, "device_id"))
    let public: string = str_trim(form_field(body, "public_key"))
    let project: string = str_trim(form_field(body, "project"))
    let area: string = str_trim(form_field(body, "area"))
    let node: string = str_trim(form_field(body, "node"))
    if token == "" || device == "" || public == "" {
        return Response{ 400, "{\"ok\":false,\"error\":\"missing enrollment fields\"}", "application/json", "" }
    }
    // The device names the file its record is kept in, and every field is one
    // field of a `|`-separated line: neither may say more than it is.
    if !valid_name(device) || !record_field_ok(public) || !record_field_ok(project) ||
        !record_field_ok(area) || !record_field_ok(node) {
        return Response{ 400, "{\"ok\":false,\"error\":\"malformed enrollment fields\"}", "application/json", "" }
    }
    let line: string = enrollment_find_token(token)
    if line == "" {
        return Response{ 403, "{\"ok\":false,\"error\":\"unknown enrollment token\"}", "application/json", "" }
    }
    if field(line, 7) == "used" {
        return Response{ 409, "{\"ok\":false,\"error\":\"enrollment token already used\"}", "application/json", "" }
    }
    let expires: u32 = u32(rho_int_from_str(field(line, 5)))
    if expires != 0 && enrollment_now() > expires {
        return Response{ 403, "{\"ok\":false,\"error\":\"enrollment token expired\"}", "application/json", "" }
    }
    let expected_device: string = field(line, 1)
    if expected_device != "" && !rho_str_eq(expected_device, device) {
        return Response{ 403, "{\"ok\":false,\"error\":\"enrollment token is for another device\"}", "application/json", "" }
    }
    let credential: string = rho_random_hex(32)
    if rho_strlen(credential) != 64 {
        return Response{ 500, "{\"ok\":false,\"error\":\"credential generation failed\"}", "application/json", "" }
    }
    let path: string = enrollment_nodes_dir() + "/" + device + ".txt"
    let record: string = device + "|" + public + "|" + project + "|" + area + "|" + node +
        "|" + credential + "|" + rho_int_to_str(enrollment_now()) + "\n"
    ignore_u32(rho_exec_args("mkdir", "-p\n" + enrollment_nodes_dir() + "\n", apps_report("enrollment-mkdir")))
    ignore_bool(rho_write_secret(path, record))
    ignore_u32(rho_exec_args("chmod", "600\n" + path + "\n", apps_report("enrollment-chmod")))
    enrollment_mark_used(token)
    info("keeper", "enrolled node " + device)
    return Response{ 200, "{\"ok\":true,\"credential\":" + json_string(credential) + "}",
        "application/json", "" }
}
