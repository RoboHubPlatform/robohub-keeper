module keeper.apps

// The applications registry.
//
// A module that declares an `application` block in its manifest is an
// application the keeper can list, open and — when it is `keeper-hosted` —
// start, stop and remove. The registry is read from the tree on every request,
// so an application that is built beside the keeper appears without a rebuild.
//
// An application that lives outside `applications/` is registered by path in
// the keeper's state directory. The same file records which applications were
// added to the keeper's own left menu.

import std.web.http
import std.web.template
import rho.log

const APPLICATIONS_DIR_NAME: string = "applications"

/* -------------------------------------------------------------------------- */
/*  State                                                                     */
/* -------------------------------------------------------------------------- */

fn applications_state_file() string {
    return keeper_state_dir() + "/applications.txt"
}

fn menu_state_file() string {
    return keeper_state_dir() + "/menu.txt"
}

fn applications_dir() string {
    return robohub_root() + "/" + APPLICATIONS_DIR_NAME
}

fn manifest_of(path: string) string {
    return path + "/module.yml"
}

fn record(name: string, path: string, origin: string) string {
    return name + "\t" + path + "\t" + origin + "\n"
}

fn records_in(dir: string, origin: string, report_name: string) string {
    if !rho_path_exists(dir) {
        return ""
    }
    let report: string = apps_report(report_name)
    ignore_u32(rho_exec_args("ls", dir + "\n", report))
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let name: string = ""
        if at < 0 {
            name = rest
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name == "" {
            continue
        }
        let path: string = dir + "/" + name
        if rho_path_exists(manifest_of(path)) &&
            (yaml.value(manifest_of(path), "module.kind") != "" || yaml.value(manifest_of(path), "application.kind") != "") {
            out = out + record(name, path, origin)
        }
    }
    return out
}

fn bundled_records() string {
    return records_in(applications_dir(), "bundled", "list-applications")
}

fn external_records() string {
    var out: string = ""
    var rest: string = rho_read_text(applications_state_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        let path: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        if name == "" || path == "" {
            continue
        }
        if rho_path_exists(manifest_of(path)) &&
            (yaml.value(manifest_of(path), "module.kind") != "" || yaml.value(manifest_of(path), "application.kind") != "") {
            out = out + record(name, path, "external")
        }
    }
    return out
}

// tsv_field is one tab-separated field of a line, or "" past the last.
fn tsv_field(line: string, index: u32) string {
    var rest: string = line
    var i: u32 = 0
    while i < index {
        let at: i32 = rho_str_index_of(rest, "\t")
        if at < 0 {
            return ""
        }
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        i = i + 1
    }
    let end: i32 = rho_str_index_of(rest, "\t")
    if end < 0 {
        return rest
    }
    return rho_str_slice(rest, 0, u32(end))
}

fn is_application(path: string) bool {
    return rho_path_exists(manifest_of(path)) &&
        (yaml.value(manifest_of(path), "module.kind") != "" || yaml.value(manifest_of(path), "application.kind") != "")
}

// registry_records are the applications published to this machine's module
// registry, the selected version of each. The toolchain says where each is, so
// the keeper never learns how the registry lays out what it installs.
fn registry_records() string {
    let report: string = apps_report("list-registry")
    if rho_exec_args("rho", "module\nlist\n--format\ntsv\n", report) != 0 {
        return ""
    }
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let path: string = tsv_field(line, 3)
        if tsv_field(line, 0) == "module" && tsv_field(line, 4) == "selected" && is_application(path) {
            out = out + record(tsv_field(line, 1), path, "registry")
        }
    }
    return out
}

// records_without drops the records whose name is already in `taken`, so one
// application is one row wherever else it is also found.
fn records_without(records: string, taken: string) string {
    var out: string = ""
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" && record_path(taken, tsv_field(line, 0)) == "" {
            out = out + line + "\n"
        }
    }
    return out
}

// workspace_records are the applications the orchestrator's registry names by
// where they are checked out (`registry/modules/<name>.yml`, `role: application`):
// an application that has a repository of its own, beside the orchestrator,
// rather than a folder in it. The registry says where; the application's own
// manifest says what it is.
fn workspace_records() string {
    let dir: string = robohub_root() + "/registry/modules"
    if !rho_path_exists(dir) {
        return ""
    }
    let report: string = apps_report("list-workspace")
    ignore_u32(rho_exec_args("ls", dir + "\n", report))
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var file: string = rest
        if at < 0 {
            rest = ""
        } else {
            file = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_index_of(file, ".yml") < 0 {
            continue
        }
        let entry: string = dir + "/" + file
        if yaml.value(entry, "role") != "application" {
            continue
        }
        let path: string = resolve_path(yaml.value(entry, "path"))
        if is_application(path) {
            out = out + record(yaml.value(manifest_of(path), "module.name"), path, "workspace")
        }
    }
    return out
}

// discovered_records are the applications the keeper finds on the machine without
// being told: the selected packages in the module registry, what the orchestrator's
// registry names in the workspace, the folders in the orchestrator's applications/
// and the folders registered by path before the catalogue. The catalogue adopts
// them on its first start; after that they are what Install offers to add.
fn discovered_records() string {
    ensure_keeper_state()
    var records: string = registry_records()
    records = records + records_without(workspace_records(), records)
    records = records + records_without(bundled_records(), records)
    return records + records_without(external_records(), records)
}

// application_records are what the keeper runs: the catalogue.
fn application_records() string {
    return catalog_records()
}

fn record_path(records: string, wanted: string) string {
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        if name != wanted {
            continue
        }
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            return tail
        }
        return rho_str_slice(tail, 0, u32(tab2))
    }
    return ""
}

fn record_origin(records: string, wanted: string) string {
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        if name != wanted {
            continue
        }
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            return "bundled"
        }
        return rho_str_slice(tail, u32(tab2) + 1, u32(rho_strlen(tail)) - u32(tab2) - 1)
    }
    return ""
}

fn app_path(name: string) string {
    return catalog_get(name, "location")
}

fn app_kind(path: string) string {
    let k: string = yaml.value(manifest_of(path), "module.kind")
    if k == "" {
        k = yaml.value(manifest_of(path), "application.kind")
    }
    return k
}

fn app_title(name: string, path: string) string {
    let title: string = yaml.value(manifest_of(path), "module.title")
    if title == "" {
        title = yaml.value(manifest_of(path), "application.title")
    }
    if title == "" {
        return name
    }
    return title
}

// app_depends returns the list of applications this app requires to be running
// before it can start, as declared in its module.yml deploy block.
fn app_depends(name: string, path: string) string {
    return app_manifest_list(path, "deploy.depends")
}

// app_calls is what an application calls on another service's behalf, one per
// line: `deploy.calls` in its manifest, such as `mesh` or `gateway:*`. Keeper
// registers the application as a client allowed those audiences and nothing else.
fn app_calls(path: string) string {
    return app_manifest_list(path, "deploy.calls")
}

// app_client_secret_file is where an application finds the secret it proves
// itself with, in its own workspace, readable by its owner only.
fn app_client_secret_file(name: string) string {
    return keeper_state_dir() + "/workspaces/" + name + "/auth/client.secret"
}

// app_client_wanted is what an application is a client for, as rho-auth reads
// it: the audiences it may ask tokens for and the scopes they grant. Every
// application may read the keeper (its API), and calls what deploy.calls names,
// each in its own namespace: `mesh` grants `mesh:*`, `gateway:*` grants
// `gateway:*`.
fn app_client_wanted(path: string) string {
    var audiences: string = "keeper"
    var scopes: string = "keeper:read"
    var rest: string = app_calls(path)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var call: string = rest
        if at < 0 { rest = "" } else { call = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        if call == "" || !auth_safe_name(call) { continue }
        let colon: i32 = rho_str_index_of(call, ":")
        var namespace: string = call
        if colon >= 0 { namespace = rho_str_slice(call, 0, u32(colon)) }
        // A call names a service: `*` would be every audience the keeper signs
        // for, its own included.
        if namespace == "" || rho_str_index_of(namespace, "*") >= 0 { continue }
        audiences = audiences + "," + call
        scopes = scopes + "," + namespace + ":*"
    }
    return audiences + "|" + scopes
}

// app_provision_client registers an application as a client of the keeper, and
// registers it again — with a new secret — when what it is a client for changed
// or `rotate` asks for a new secret. It answers the file the secret is in, or ""
// when it could not be registered.
fn app_provision_client(name: string, path: string) string {
    return app_provision_client_with(name, path, false)
}

fn app_provision_client_with(name: string, path: string, rotate: bool) string {
    if !auth_safe_name(name) {
        return ""
    }
    let secret_file: string = app_client_secret_file(name)
    let wanted: string = app_client_wanted(path)
    let record: string = keeper_state_dir() + "/workspaces/" + name + "/auth/client.wanted"
    if !rotate && rho_path_exists(secret_file) && rho_str_eq(str_trim(rho_read_text(record)), wanted) {
        return secret_file
    }
    let store: string = auth_dir() + "/clients"
    ignore_u32(rho_exec_args("rho", "auth\nclient\nremove\n--store\n" + store + "\n--id\n" + name + "\n", apps_report("client-remove-" + name)))
    let args: string = "auth\nclient\nadd\n--store\n" + store + "\n--id\n" + name +
        "\n--audiences\n" + field(wanted, 0) + "\n--scopes\n" + field(wanted, 1) + "\n--secret-out\n" + secret_file + "\n"
    ignore_u32(rho_exec_args("mkdir", "-p\n" + keeper_state_dir() + "/workspaces/" + name + "/auth\n", apps_report("mkdir-client")))
    if rho_exec_args("rho", args, apps_report("client-" + name)) != 0 || !rho_path_exists(secret_file) {
        ignore_u32(keeper_alert("ERROR", "Application " + name + " could not be registered as a client", "app=" + name))
        return ""
    }
    ignore_bool(rho_write_text(record, wanted + "\n"))
    info("keeper", "registered application " + name + " as a client for " + field(wanted, 0))
    return secret_file
}

// app_remove_client takes an application's client away with it.
fn app_remove_client(name: string) void {
    if !auth_safe_name(name) {
        return
    }
    ignore_u32(rho_exec_args("rho", "auth\nclient\nremove\n--store\n" + auth_dir() + "/clients\n--id\n" + name + "\n", apps_report("client-remove-" + name)))
    ignore_u32(rho_exec_args("rm", "-f\n" + app_client_secret_file(name) + "\n" + keeper_state_dir() + "/workspaces/" + name + "/auth/client.wanted\n", apps_report("client-forget-" + name)))
}

// app_env_name is a service name as part of an environment variable's name:
// `mesh` becomes `MESH`, `my-app` becomes `MY_APP`.
fn app_env_name(name: string) string {
    let lower: string = "abcdefghijklmnopqrstuvwxyz-."
    let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ__"
    var out: string = ""
    var i: u32 = 0
    while i < u32(rho_strlen(name)) {
        let c: string = rho_str_slice(name, i, 1)
        let at: i32 = rho_str_index_of(lower, c)
        if at >= 0 {
            out = out + rho_str_slice(upper, u32(at), 1)
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// app_manifest_list reads a list a manifest declares at `key`, one item per line.
fn app_manifest_list(path: string, key: string) string {
    let raw: string = yaml.value(path + "/module.yml", key)
    if raw == "" { return "" }
    var out: string = ""
    var rest: string = raw
    if rho_str_starts_with(rest, "[") {
        rest = rho_str_slice(rest, 1, u32(rho_strlen(rest)) - 2)
    }
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, ",")
        var token: string = rest
        if at < 0 { rest = "" } else { token = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        token = str_trim(token)
        if rho_str_starts_with(token, "\"") && rho_str_slice(token, u32(rho_strlen(token)) - 1, 1) == "\"" {
            token = rho_str_slice(token, 1, u32(rho_strlen(token)) - 2)
        }
        if token == "" { continue }
        out = out + token + "\n"
    }
    return out
}

fn app_port(path: string) string {
    let port: string = yaml.value(manifest_of(path), "module.port")
    if port == "" {
        port = yaml.value(manifest_of(path), "application.port")
    }
    if port != "" { return port }
    return yaml.value(manifest_of(path), "deploy.port")
}

fn app_route(path: string) string {
    let address: string = yaml.value(manifest_of(path), "module.route")
    if address == "" {
        address = yaml.value(manifest_of(path), "application.route")
    }
    if address == "" {
        return "/"
    }
    return address
}

fn app_command(name: string, path: string) string {
    let command: string = yaml.value(manifest_of(path), "module.command")
    if command == "" {
        command = yaml.value(manifest_of(path), "application.command")
    }
    if command == "" {
        return name
    }
    return command
}

fn app_version(path: string) string {
    return yaml.value(manifest_of(path), "module.version")
}

/* -------------------------------------------------------------------------- */
/*  Running and menu state                                                    */
/* -------------------------------------------------------------------------- */

fn port_answers(port: string, path: string) bool {
    if port == "" {
        return false
    }
    let report: string = apps_report("probe-" + port)
    let code: u32 = rho_exec_args("curl", "-fsS\n-m\n1\n-o\n/dev/null\nhttp://127.0.0.1:" + port + path + "\n", report)
    return code == 0
}

// app_binary is the application's program: the one a build in its folder made,
// or, for a published application, the one its package carries.
fn app_binary(name: string, path: string) string {
    let built: string = path + "/build/" + app_command(name, path)
    if !rho_path_exists(built) && rho_path_exists(path + "/" + app_command(name, path)) {
        return path + "/" + app_command(name, path)
    }
    return built
}

fn app_running(name: string, path: string) bool {
    if app_kind(path) == "keeper" {
        return true
    }
    return app_healthy(name)
}

fn pinned(name: string) bool {
    return line_in_list(rho_read_text(menu_state_file()), name)
}

fn pin(name: string) void {
    ignore_bool(rho_write_text(menu_state_file(),
        list_add(rho_read_text(menu_state_file()), name)))
}

fn unpin(name: string) void {
    ignore_bool(rho_write_text(menu_state_file(),
        list_remove(rho_read_text(menu_state_file()), name)))
}

/* -------------------------------------------------------------------------- */
/*  Pages                                                                     */
/* -------------------------------------------------------------------------- */

fn page(req: Request, title: string, content: string) Response {
    return page_status(req, status_ok(), title, content)
}

fn page_status(req: Request, status: u32, title: string, content: string) Response {
    let document: string = template_fill(template_get("layout"),
        vars("title", title) + vars("htmx", htmx_head()) + vars("ui_head", ui_head()) +
        vars("theme", ui_theme(req)) + i18n_vars(req) + vars("topbar", keeper_topbar(req)) +
        vars("nav", keeper_nav(req)) + vars("notifications", notification_embed()) + vars("body", content))
    return html(status, document)
}

// keeper_switcher_apps are the applications for the top bar's switcher, as
// robohub.ui reads them: name|title|port|route|state, the keeper first. The state
// is systemd's word, which is cheap; the health probe is for the pages.
fn keeper_switcher_apps() string {
    var out: string = "keeper|Keeper||/|keeper\n"
    var rest: string = catalog_names()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 { rest = "" } else { name = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        let path: string = app_path(name)
        if name == "" || app_kind(path) != "keeper-hosted" {
            continue
        }
        var state: string = app_active(name)
        if rho_str_eq(state, "active") {
            state = "running"
        } else if rho_str_eq(state, "none") || rho_str_eq(state, "inactive") {
            state = "stopped"
        }
        out = out + name + "|" + app_title(name, path) + "|" + app_port_of(name) + "|" + app_route(path) + "|" + state + "\n"
    }
    keeper_write_proxy(out)
    return out
}

// keeper_proxy_on is whether the keeper's links to its applications go through
// its own origin (/app/<name>/) rather than to their ports: on unless turned off.
fn keeper_proxy_on() bool {
    return !rho_str_eq(settings_get("keeper.proxy_apps", "on"), "off")
}

// keeper_app_href is where the keeper sends a person for an application.
fn keeper_app_href(name: string, first_page: string) string {
    var first: string = first_page
    if first == "" {
        first = "/"
    }
    return "/app/" + name + first
}

// keeper_proxy_file is the list the app_proxy middleware reads: where its
// project.yml says, in the keeper's home folder.
fn keeper_proxy_file() string {
    return getenv("HOME") + "/.rho/keeper/proxy.txt"
}

// keeper_write_proxy writes the hosted applications and their ports for the
// proxy, `name port` per line, when they changed.
fn keeper_write_proxy(apps: string) void {
    var out: string = ""
    var rest: string = apps
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else { line = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        let name: string = field(line, 0)
        let port: string = field(line, 2)
        if name != "" && !rho_str_eq(name, "keeper") && port != "" {
            out = out + name + " " + port + "\n"
        }
    }
    if !rho_str_eq(rho_read_text(keeper_proxy_file()), out) {
        ignore_u32(rho_exec_args("mkdir", "-p\n" + getenv("HOME") + "/.rho/keeper\n", apps_report("proxy-mkdir")))
        ignore_bool(rho_write_text(keeper_proxy_file(), out))
    }
}

fn keeper_topbar(req: Request) string {
    let subject: string = people_subject(req)
    var who: string = subject
    if people_has(subject) {
        who = people_get(subject, "display")
    }
    if rho_str_eq(subject, "access-token") || rho_str_eq(subject, "operator") {
        who = i18n_t(req, "topbar.admin")
    }
    if who == "" {
        who = i18n_t(req, "topbar.signed_in")
    }
    var links: string = "<h6>" + i18n_t(req, "topbar.you") + "</h6><a href=\"/account\">" + i18n_t(req, "topbar.account") + "</a>"
    if keeper_allowed(req, "admin") {
        links = links + "<a href=\"/people\">" + i18n_t(req, "nav.people_access") + "</a><a href=\"/settings\">" + i18n_t(req, "nav.settings") + "</a>"
    }
    links = links + ui_language(i18n_locale(req), request_path(req))
    return keeper_ui_labels(req, ui_topbar("keeper", keeper_switcher_apps(), "",
        ui_person(req, who, people_role_label(req, people_role(req)), links, "<a href=\"/logout\">" + i18n_t(req, "topbar.sign_out") + "</a>", true)))
}

// keeper_ui_labels puts the few words the shared robohub.ui module writes in
// English into the request's language: the headings of its menus, the theme
// choices and the state words of the switcher. The module takes no labels, and
// the state stays English where it names a class (rh-dot), so only the words a
// person reads are swapped, each where it is a whole text between tags.
fn keeper_ui_labels(req: Request, bar: string) string {
    var out: string = bar
    out = i18n_replace_all(out, "<h6>Applications</h6>", "<h6>" + i18n_t(req, "nav.applications") + "</h6>")
    out = i18n_replace_all(out, "<h6>Theme</h6>", "<h6>" + i18n_t(req, "topbar.theme") + "</h6>")
    out = i18n_replace_all(out, "<h6>Language</h6>", "<h6>" + i18n_t(req, "topbar.language") + "</h6>")
    out = i18n_replace_all(out, "\">dark</a>", "\">" + i18n_t(req, "topbar.theme_dark") + "</a>")
    out = i18n_replace_all(out, "\">light</a>", "\">" + i18n_t(req, "topbar.theme_light") + "</a>")
    out = i18n_replace_all(out, "\">system</a>", "\">" + i18n_t(req, "topbar.theme_system") + "</a>")
    out = i18n_replace_all(out, "<small>running</small>", "<small>" + i18n_t(req, "topbar.state_running") + "</small>")
    out = i18n_replace_all(out, "<small>stopped</small>", "<small>" + i18n_t(req, "topbar.state_stopped") + "</small>")
    out = i18n_replace_all(out, "<small>keeper</small>", "<small>" + i18n_t(req, "topbar.state_keeper") + "</small>")
    return out
}

// keeper_rail_link is one place in the rail, marked when the page is it or under it.
fn keeper_rail_link(req: Request, href: string, icon: string, label: string, extra: string) string {
    let path: string = request_path(req)
    var on: string = ""
    if rho_str_eq(path, href) || (href != "/" && rho_str_starts_with(path, href + "/")) {
        on = " class=\"on\""
    }
    // A phone has room for four places in its bottom bar.
    var phone: string = ""
    if rho_str_eq(href, "/") || rho_str_eq(href, "/applications") || rho_str_eq(href, "/jobs") || rho_str_eq(href, "/settings") {
        phone = " data-phone"
    }
    return "<a" + on + phone + " href=\"" + href + "\"><i>" + icon + "</i>" + label + extra + "</a>"
}

// keeper_nav is the rail: places only. Applications are reached through the
// switcher; the ones added to the menu are listed under Applications too.
fn keeper_nav(req: Request) string {
    return keeper_rail_link(req, "/", "◉", i18n_t(req, "nav.home"), "") +
        keeper_rail_link(req, "/applications", "▦", i18n_t(req, "nav.applications"), "") +
        pinned_nav(req) +
        keeper_rail_link(req, "/plugins", "⛁", i18n_t(req, "nav.plugins"), "") +
        "<a class=\"sub more\" href=\"/providers\">" + i18n_t(req, "nav.providers") + "</a>" +
        "<a class=\"sub more\" href=\"/app-modules\">" + i18n_t(req, "nav.app_modules") + "</a>" +
        keeper_rail_link(req, "/jobs", "☰", i18n_t(req, "nav.jobs"), "") +
        "<h6>" + i18n_t(req, "nav.people") + "</h6>" +
        keeper_rail_link(req, "/people", "☺", i18n_t(req, "nav.people_access"), "") +
        keeper_rail_link(req, "/auth/token", "✦", i18n_t(req, "nav.recovery_token"), "") +
        keeper_rail_link(req, "/nodes", "◎", i18n_t(req, "page.nodes"), "") +
        "<h6>" + i18n_t(req, "nav.machine") + "</h6>" +
        keeper_rail_link(req, "/system", "⚙", i18n_t(req, "nav.system"), "") +
        keeper_rail_link(req, "/docs", "▧", i18n_t(req, "nav.docs"), "") +
        keeper_rail_link(req, "/settings", "⚑", i18n_t(req, "nav.settings"), "")
}

// pinned_nav is the applications added to the menu, as sub-links of
// Applications that lead to their pages.
fn pinned_nav(req: Request) string {
    var out: string = ""
    var rest: string = rho_read_text(menu_state_file())
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 { rest = "" } else { name = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        if name == "" || !catalog_has(name) {
            continue
        }
        let path: string = app_path(name)
        if app_kind(path) == "keeper" {
            continue
        }
        // The keeper's page of the application, which opens it from there: a menu
        // entry that left the keeper at once was a surprise.
        var cls: string = "sub"
        if rho_str_eq(request_path(req), "/apps/" + name) {
            cls = "sub on"
        }
        out = out + "<a class=\"" + cls + "\" href=\"/apps/" + escape_html(name) + "\">" + escape_html(app_title(name, path)) + "</a>"
    }
    return out
}

fn open_link(req: Request, name: string, path: string) string {
    if app_kind(path) == "keeper" {
        return "<a class=\"button quiet\" href=\"/\">" + i18n_t(req, "common.open") + "</a>"
    }
    if keeper_proxy_on() {
        return "<a class=\"button\" href=\"" + escape_html(keeper_app_href(name, app_route(path))) +
            "\" target=\"_blank\" rel=\"noopener\">" + i18n_t(req, "apps.open_application") + " ↗</a>"
    }
    return "<a class=\"button app-open\" href=\"#\" target=\"_blank\" rel=\"noopener\" data-app-port=\"" +
        escape_html(app_port_of(name)) + "\" data-app-route=\"" +
        escape_html(app_route(path)) + "\">" + i18n_t(req, "apps.open_application") + " ↗</a>"
}

fn app_actions(req: Request, name: string, path: string, origin: string) string {
    var hint: string = i18n_t(req, "apps.uninstall_hint")
    if origin == "fetched" {
        hint = i18n_t(req, "apps.uninstall_hint_fetched")
    }
    let running: string = ""
    let state: string = app_state(name)
    if rho_str_eq(state, "running") || rho_str_eq(state, "starting") {
        running = "true"
    }
    let pinned_flag: string = ""
    if pinned(name) {
        pinned_flag = "true"
    }
    let is_keeper: string = ""
    if app_kind(path) == "keeper" {
        is_keeper = "true"
    }
    return template_fill(template_get("app-actions"),
        vars("open", open_link(req, name, path)) +
        vars("name", name) +
        vars("origin", origin) +
        vars("hint", hint) +
        vars("running", running) +
        vars("pinned", pinned_flag) +
        vars("is_keeper", is_keeper) +
        // hx-confirm takes the question itself, escaped as an attribute.
        vars("redeploy_confirm", keeper_t1(req, "apps.redeploy_confirm", "name", name)) +
        vars("uninstall_confirm", i18n_t(req, "apps.uninstall_confirm")) +
        i18n_vars(req))
}

fn app_status(tone: string, label: string) string {
    return template_fill(template_get("status"), vars("tone", tone) + vars("label", label))
}

// application_status is the state word as the row shows it, with the job an
// application is busy with in place of its state.
fn application_status(req: Request, name: string, path: string) string {
    let job: string = job_running_for(name)
    if job != "" {
        return app_status("busy", job_action_words(keeper_lang(req), job_meta(job, 1)) + "…")
    }
    let state: string = app_state(name)
    if rho_str_eq(state, "keeper") { return app_status("running", i18n_t(req, "apps.state.keeper")) }
    if rho_str_eq(state, "running") { return app_status("running", i18n_t(req, "apps.state.running")) }
    if rho_str_eq(state, "starting") { return app_status("busy", i18n_t(req, "apps.state.starting")) }
    if rho_str_eq(state, "failed") { return app_status("failed", i18n_t(req, "apps.state.failed")) }
    if rho_str_eq(state, "not-built") { return app_status("not-built", i18n_t(req, "apps.state.not_built")) }
    if rho_str_eq(state, "not-deployed") { return app_status("stopped", i18n_t(req, "apps.state.no_service")) }
    return app_status("stopped", i18n_t(req, "apps.state.stopped"))
}

fn application_row_html(req: Request, name: string, path: string, origin: string) string {
    return template_fill(template_get("application-row"),
        vars("name", name) +
        vars("title", app_title(name, path)) +
        vars("kind", app_kind(path)) +
        vars("version", app_version(path)) +
        vars("path", path) +
        vars("status", application_status(req, name, path)) +
        vars("actions", app_actions(req, name, path, origin)) +
        vars("log_link", "/applications/log?name=" + escape_html(name)) +
        i18n_vars(req))
}

fn applications_rows(req: Request) string {
    let records: string = application_records()
    var out: string = ""
    var rest: string = records
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab < 0 {
            continue
        }
        let name: string = rho_str_slice(line, 0, u32(tab))
        let tail: string = rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        let tab2: i32 = rho_str_index_of(tail, "\t")
        if tab2 < 0 {
            continue
        }
        let path: string = rho_str_slice(tail, 0, u32(tab2))
        let origin: string = rho_str_slice(tail, u32(tab2) + 1, u32(rho_strlen(tail)) - u32(tab2) - 1)
        out = out + application_row_html(req, name, path, origin) + "\n"
    }
    if out == "" {
        out = "<tr><td colspan=\"6\">" + i18n_t(req, "apps.none_before") + " <code>application</code> " + i18n_t(req, "apps.none_after") + "</td></tr>"
    }
    return out
}

// applications_candidates are the applications found on this machine that the
// keeper does not run, each with a button that adds it.
fn applications_candidates(req: Request) string {
    var out: string = ""
    var rest: string = catalog_candidates()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else { line = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        let name: string = tsv_field(line, 0)
        let path: string = tsv_field(line, 1)
        if name == "" || app_kind(path) != "keeper-hosted" {
            continue
        }
        out = out + "<tr><td>" + escape_html(app_title(name, path)) + "</td><td>" + escape_html(app_version(path)) +
            "</td><td><code>" + escape_html(path) + "</code></td><td><a class=\"button\" href=\"/applications/preview?add=" +
            escape_html(name) + "\">" + i18n_t(req, "apps.add_candidate") + "</a></td></tr>"
    }
    if out == "" {
        return "<tr><td colspan=\"4\">" + i18n_t(req, "apps.no_candidates") + "</td></tr>"
    }
    return out
}

fn applications_candidates_endpoint(req: Request) Response {
    return html(status_ok(), applications_candidates(req))
}

fn applications_rows_endpoint(req: Request) Response {
    return html(status_ok(), applications_rows(req))
}

fn keeper_app_log_path(name: string) string {
    return log_file_in_settings_file(keeper_state_dir() + "/workspaces/" + name +
        "/data/settings.conf", name)
}

// applications_log is what systemd recorded of an application: its output and
// systemd's own lines about starting, failing and restarting it.
fn applications_log(req: Request) Response {
    let name: string = str_trim(request_query_param(req, "name"))
    if !catalog_has(name) {
        return page(req, i18n_t(req, "common.log"), "<h1>" + i18n_t(req, "common.log") + "</h1><p>" + i18n_t(req, "apps.log.unknown") + "</p>")
    }
    let path: string = app_path(name)
    let text: string = app_journal(name, 300)
    var body: string = "<h1>" + i18n_t(req, "common.log") + " · " + escape_html(app_title(name, path)) +
        "</h1><p>" + i18n_t(req, "apps.log.from_journal") + " <code>" + escape_html(app_unit_name(name)) + ".service</code>.</p>"
    if str_trim(text) == "" || rho_str_index_of(text, "No entries") >= 0 {
        body = body + "<p>" + i18n_t(req, "apps.log.nothing") + "</p>"
    }
    let file: string = keeper_app_log_path(name)
    if rho_path_exists(file) {
        body = body + "<p>" + i18n_t(req, "apps.log.also_writes") + " <code>" + escape_html(file) + "</code>.</p>"
    }
    return page(req, i18n_t(req, "common.log") + " · " + name, body +
        "<pre class=\"log-tail\" style=\"white-space:pre-wrap;word-break:break-word;\">" +
        escape_html(text) + "</pre>")
}

fn applications_page_message(req: Request, message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"), vars("message", message))
    }
    let body: string = template_fill(template_get("applications"),
        vars("notice", notice) + vars("rows", applications_rows(req)) + vars("install_form", applications_install_form(req)) + vars("registry", integrations_section(req) + registry_section(req)) +
        i18n_vars(req))
    return page(req, i18n_t(req, "page.applications"), body)
}

// applications_install_form is the form an application is installed from, drawn
// by the shared forms module with its CSRF token. "Check what it needs" shows
// the preview first; Install goes straight on.
// keeper_install_form is an install form for a plugin, a provider or a module,
// drawn by the shared forms module with its CSRF token.
fn keeper_install_form(req: Request, action: string, name_hint: string, source_hint: string, source_help: string) string {
    var fields: FormField[2]
    fields[0] = FormField{ "source", "text", i18n_t(req, "common.source"), source_help, source_hint, true, "", "", "", "", "" }
    fields[1] = FormField{ "name", "text", i18n_t(req, "common.name"), i18n_t(req, "apps.form.name_help_folder"), name_hint, false, "", "", "", "", "" }
    return "<form class=\"panel-form app-install\" method=\"post\" action=\"" + action + "\">" + forms_csrf_field() +
        forms_body(fields, 2) + "<div class=\"form-actions\"><button type=\"submit\">" + i18n_t(req, "common.install") + "</button></div></form>"
}

fn applications_install_form(req: Request) string {
    var fields: FormField[3]
    fields[0] = FormField{ "source", "text", i18n_t(req, "common.source"), i18n_t(req, "apps.form.source_help"),
        i18n_t(req, "apps.form.source_hint"), false, "", "", "", "", "" }
    fields[1] = FormField{ "name", "text", i18n_t(req, "common.name"), i18n_t(req, "apps.form.name_help"),
        "mesh", false, "", "", "", "", "" }
    fields[2] = FormField{ "menu", "toggle", i18n_t(req, "apps.form.menu"), "", "", false, "", "", "", "", "" }
    var package_fields: FormField[1]
    package_fields[0] = FormField{ "package", "text", i18n_t(req, "apps.form.package"), i18n_t(req, "apps.form.package_help"), "aquarium", true, "", "", "", "", "" }
    return "<form class=\"panel-form app-install\" method=\"post\" action=\"/applications/install\">" + forms_csrf_field() +
        forms_body(fields, 3) + "<div class=\"form-actions\">" +
        "<button type=\"submit\" class=\"quiet\" formaction=\"/applications/preview\" formmethod=\"get\">" + i18n_t(req, "apps.form.check") + "</button>" +
        "<button type=\"submit\">" + i18n_t(req, "common.install") + "</button></div></form>" +
        "<form class=\"panel-form app-install\" method=\"post\" action=\"/applications/install\">" + forms_csrf_field() +
        forms_body(package_fields, 1) + "<div class=\"form-actions\"><button type=\"submit\">" + i18n_t(req, "apps.form.install_registry") + "</button></div></form>"
}

fn applications_page(req: Request) Response {
    return applications_page_message(req, "")
}

/* -------------------------------------------------------------------------- */
/*  Actions                                                                   */
/* -------------------------------------------------------------------------- */

fn applications_menu(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    let name: string = str_trim(form_field(body, "name"))
    let wanted: string = form_field(body, "pinned")
    if name == "" || app_path(name) == "" {
        return applications_page_message(req, keeper_t1(req, "common.no_such_application", "name", name))
    }
    if wanted == "0" {
        unpin(name)
        info("keeper", "removed " + name + " from the keeper menu")
        if htmx_is_request(req) {
            return application_row_response(req, name)
        }
        return applications_page_message(req, keeper_t1(req, "apps.unpinned", "name", name))
    }
    pin(name)
    info("keeper", "added " + name + " to the keeper menu")
    if htmx_is_request(req) {
        return application_row_response(req, name)
    }
    return applications_page_message(req, keeper_t1(req, "apps.pinned", "name", name))
}

// The port this keeper listens on, said to a hosted application so it can
// offer a way back. RHO_HTTP_ADDR is `:8080`, `127.0.0.1:19090` or a bare port.
fn keeper_listen_port() string {
    let address: string = getenv("RHO_HTTP_ADDR")
    if address == "" {
        // Fall back to the keeper's own deploy.port; the deploy script sets
        // RHO_HTTP_ADDR, so this only matters for a keeper started by hand.
        return "19090"
    }
    var port: string = ""
    var rest: string = address
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, ":")
        if at < 0 {
            if port == "" {
                port = rest
            }
            break
        }
        port = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
    }
    if port == "" {
        return "8080"
    }
    return port
}

fn app_start(lang: string, name: string) string {
    return app_start_chain(lang, name, "\n")
}

// app_start_chain starts an application after the ones it depends on. `chain`
// is the applications already being started on the way here, one per line, so
// two applications that depend on each other stop at the second rather than
// starting each other for ever. The unit is written first when it is missing or
// no longer describes the application; an application that was never built is
// built and started by a job.
fn app_start_chain(lang: string, name: string, chain: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    let path: string = app_path(name)
    if app_kind(path) == "keeper" {
        return keeper_say(lang, "action.keeper_no_start")
    }
    let port: string = app_port_of(name)
    if port == "" {
        return keeper_say1(lang, "action.no_port", "name", name)
    }
    // What it needs from the machine comes first: a program that is not there is
    // a start that fails in a way the journal says badly.
    let missing: string = deps_missing(name, true)
    if missing != "" {
        return keeper_say2(lang, "action.needs_dep", "name", name, "dep", first_line(missing))
    }
    var plan_rest: string = app_depends(name, path)
    while plan_rest != "" {
        let plan_at: i32 = rho_str_index_of(plan_rest, "\n")
        var dep_name: string = plan_rest
        if plan_at < 0 { plan_rest = "" } else { dep_name = rho_str_slice(plan_rest, 0, u32(plan_at)); plan_rest = rho_str_slice(plan_rest, u32(plan_at) + 1, u32(rho_strlen(plan_rest)) - u32(plan_at) - 1) }
        if dep_name == "" || dep_name == name || !catalog_has(dep_name) { continue }
        if rho_str_index_of(chain, "\n" + dep_name + "\n") >= 0 {
            return keeper_say2(lang, "action.depend_cycle", "name", name, "dep", dep_name)
        }
        if !app_running(dep_name, app_path(dep_name)) {
            let dep_msg: string = app_start_chain(lang, dep_name, chain + name + "\n")
            // It started when it said so, in either of the two ways a start
            // succeeds; anything else is why it did not.
            let dep_port: string = app_port_of(dep_name)
            if !rho_str_eq(dep_msg, keeper_say2(lang, "action.starting", "name", dep_name, "port", dep_port)) &&
                !rho_str_eq(dep_msg, keeper_say2(lang, "action.built_started_port", "name", dep_name, "port", dep_port)) {
                return keeper_say2(lang, "action.dep_failed", "dep", dep_name, "message", dep_msg)
            }
        }
    }
    if job_running_for(name) != "" {
        return keeper_say1(lang, "action.busy_starts_after", "name", name)
    }
    let changed: bool = app_install_unit(name)
    if !rho_path_exists(app_program(name)) {
        if job_start_built(name) == "" {
            return keeper_say1(lang, "common.busy_with_job", "name", name)
        }
        return keeper_say2(lang, "action.built_started_port", "name", name, "port", port)
    }
    var verb: string = "start"
    if changed && rho_str_eq(app_active(name), "active") {
        verb = "restart"
    }
    if app_systemd(verb + "\n" + app_unit_name(name) + "\n", verb + "-" + name) != 0 {
        ignore_u32(keeper_alert("ERROR", "Application " + name + " could not start", "app=" + name))
        return keeper_say1(lang, "action.start_failed", "name", name)
    }
    info("keeper", "started application " + name)
    keeper_event("app.started", name, name + " is starting on port " + port + ".")
    return keeper_say2(lang, "action.starting", "name", name, "port", port)
}

fn app_stop(lang: string, name: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    if app_kind(app_path(name)) == "keeper" {
        return keeper_say(lang, "action.keeper_no_stop")
    }
    if !rho_path_exists(app_unit_file(name)) {
        return keeper_say1(lang, "action.no_service", "name", name)
    }
    if app_systemd("stop\n" + app_unit_name(name) + "\n", "stop-" + name) != 0 {
        return keeper_say1(lang, "action.stop_failed", "name", name)
    }
    info("keeper", "stopped application " + name)
    keeper_event("app.stopped", name, name + " was stopped.")
    return keeper_say1(lang, "action.stopped", "name", name)
}

// app_build_job builds an application in the background; what runs is not
// touched, and Restart runs the new build.
fn app_build_job(lang: string, name: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    if rho_str_eq(catalog_get(name, "origin"), "registry") {
        return keeper_say1(lang, "action.published_package", "name", name)
    }
    if job_build(name) == "" {
        return keeper_say1(lang, "common.busy_with_job", "name", name)
    }
    return keeper_say1(lang, "action.building", "name", name)
}

// app_canonical is a folder's path with no `..` and no symbolic link in it,
// which is how a service unit names it.
fn app_canonical(path: string) string {
    let report: string = apps_report("realpath")
    if rho_exec_args("realpath", "-e\n" + path + "\n", report) != 0 {
        return path
    }
    let resolved: string = first_line(rho_read_text(report))
    if resolved == "" {
        return path
    }
    return resolved
}

fn app_artifact_dir(name: string) string {
    return keeper_state_dir() + "/artifacts/" + name
}

fn app_artifact_incoming_dir() string {
    return keeper_state_dir() + "/incoming"
}

// app_artifact_incoming finds the newest staged archive for an application.
fn app_artifact_incoming(name: string) string {
    let report: string = apps_report("incoming-" + name)
    ignore_u32(rho_exec_args("ls", "-t\n" + app_artifact_incoming_dir() + "\n", report))
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 { rest = "" } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_index_of(line, name + "-") == 0 || rho_str_eq(line, name + ".tar.gz") {
            return app_artifact_incoming_dir() + "/" + line
        }
    }
    return ""
}

fn app_artifact_verify(archive: string) u32 {
    let report: string = apps_report("artifact-verify")
    let key: string = getenv("ROBOHUB_ARTIFACT_PUBKEY")
    if key != "" {
        return rho_exec_args("rho", "artifact\nverify\n-pub\n" + key + "\n" + archive + "\n", report)
    }
    // Checksum verification is always performed. Signature verification needs
    // the build key a deployment trusts; without it an unsigned artifact is
    // accepted only when the operator explicitly allows it.
    if rho_str_eq(getenv("ROBOHUB_ARTIFACT_ALLOW_UNSIGNED"), "1") {
        return rho_exec_args("rho", "artifact\nverify\n-allow-unsigned\n" + archive + "\n", report)
    }
    return rho_exec_args("rho", "artifact\nverify\n" + archive + "\n", report)
}

fn app_artifact_link(binary: string, target: string) void {
    let next: string = binary + ".next"
    ignore_u32(rho_exec_args("ln", "-sfn\n" + target + "\n" + next + "\n",
        apps_report("artifact-link")))
    ignore_u32(rho_exec_args("mv", "-Tf\n" + next + "\n" + binary + "\n",
        apps_report("artifact-swap")))
}

// app_update_artifact stages and swaps a signed artifact. "ok" means installed,
// "" means no artifact was staged, and anything else is the failure message.
fn app_update_artifact(lang: string, name: string, path: string) string {
    let archive: string = app_artifact_incoming(name)
    if archive == "" {
        return ""
    }
    if app_artifact_verify(archive) != 0 {
        return keeper_say1(lang, "action.artifact_verify_failed", "report", apps_report("artifact-verify"))
    }
    let inspectReport: string = apps_report("artifact-inspect")
    ignore_u32(rho_exec_args("rho", "artifact\ninspect\n" + archive + "\n", inspectReport))
    let inspected: string = rho_read_text(inspectReport)
    let version: string = app_artifact_value(inspected, "version")
    let entrypoint: string = app_artifact_value(inspected, "entrypoint")
    let service: string = app_artifact_value(inspected, "service")
    let health: string = app_artifact_value(inspected, "health")
    if version == "" || entrypoint == "" {
        return keeper_say(lang, "action.artifact_no_entry")
    }
    if service != "" && !rho_str_eq(service, name) {
        return keeper_say2(lang, "action.artifact_other_service", "service", service, "name", name)
    }
    let destination: string = app_artifact_dir(name) + "/" + version
    ignore_u32(rho_exec_args("mkdir", "-p\n" + destination + "\n", apps_report("artifact-mkdir")))
    let extractReport: string = apps_report("artifact-extract")
    var extractArgs: string = "artifact\nverify\n-extract\n" + destination + "\n"
    let pub: string = getenv("ROBOHUB_ARTIFACT_PUBKEY")
    if pub != "" {
        extractArgs = extractArgs + "-pub\n" + pub + "\n"
    } else if rho_str_eq(getenv("ROBOHUB_ARTIFACT_ALLOW_UNSIGNED"), "1") {
        extractArgs = extractArgs + "-allow-unsigned\n"
    }
    if rho_exec_args("rho", extractArgs + archive + "\n", extractReport) != 0 {
        return keeper_say1(lang, "action.artifact_extract_failed", "report", extractReport)
    }
    let binary: string = app_binary(name, path)
    var previous: string = ""
    if rho_path_exists(binary) {
        let linkReport: string = apps_report("artifact-readlink")
        ignore_u32(rho_exec_args("readlink", "-f\n" + binary + "\n", linkReport))
        previous = first_line(rho_read_text(linkReport))
        if previous == "" {
            previous = binary + ".pre-artifact"
            ignore_u32(rho_exec_args("mv", "-f\n" + binary + "\n" + previous + "\n",
                apps_report("artifact-previous")))
        }
    }
    let target: string = destination + "/" + entrypoint
    if !rho_path_exists(target) {
        return keeper_say1(lang, "action.artifact_entry_missing", "entrypoint", entrypoint)
    }
    app_artifact_link(binary, target)
    if previous != "" {
        ignore_bool(rho_write_text(app_artifact_dir(name) + "/previous", previous + "\n"))
    }
    ignore_string(app_restart(lang, name))
    let timeout: u32 = u32(rho_int_from_str(app_artifact_value(inspected, "health_timeout")))
    if timeout == 0 { timeout = 20 }
    let port: string = app_port(path)
    if health != "" && port != "" {
        var waited: u32 = 0
        var healthy: bool = false
        while waited < timeout {
            if rho_exec_args("curl", "-fsS\n--max-time\n2\nhttp://127.0.0.1:" + port + health + "\n",
                apps_report("artifact-health")) == 0 {
                healthy = true
                break
            }
            ignore_u32(rho_exec_args("sleep", "1\n", apps_report("artifact-wait")))
            waited = waited + 1
        }
        if !healthy {
            if previous != "" {
                app_artifact_link(binary, previous)
                ignore_string(app_restart(lang, name))
                return keeper_say1(lang, "action.health_rolled_back", "name", name)
            }
            return keeper_say(lang, "action.health_no_previous")
        }
    }
    ignore_u32(rho_exec_args("mv", "-f\n" + archive + "\n" + app_artifact_dir(name) + "/" + version + ".tar.gz" + "\n",
        apps_report("artifact-archive")))
    info("keeper", "deployed artifact " + name + " " + version)
    return "ok"
}

// app_redeploy installs a staged artifact when there is one; otherwise it
// writes the unit for where the application is now and starts a job that builds
// it, restarts it and waits for it to answer. A build that fails leaves the
// running program alone.
fn app_redeploy(lang: string, name: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    let path: string = app_path(name)
    if app_kind(path) == "keeper" {
        return keeper_say(lang, "action.keeper_no_redeploy")
    }
    let artifact: string = app_update_artifact(lang, name, path)
    if rho_str_eq(artifact, "ok") {
        catalog_refresh_version(name)
        return keeper_say1(lang, "action.artifact_updated", "name", name)
    }
    if artifact != "" {
        return keeper_say1(lang, "action.artifact_failed", "reason", artifact)
    }
    if app_port_of(name) == "" {
        return app_build_job(lang, name)
    }
    ignore_bool(app_install_unit(name))
    if job_redeploy(name) == "" {
        return keeper_say1(lang, "common.busy_with_job", "name", name)
    }
    return keeper_say1(lang, "action.redeploying", "name", name)
}

// app_rollback puts the release before the one in use back in use, by a job that
// restarts the application on it.
fn app_rollback(lang: string, name: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    if !app_released(name) {
        return keeper_say1(lang, "action.no_releases", "name", name)
    }
    if job_rollback(name) == "" {
        return keeper_say1(lang, "common.busy_with_job", "name", name)
    }
    keeper_event("app.rollback", name, name + " is going back to its previous release.")
    return keeper_say1(lang, "action.rolling_back", "name", name)
}

// app_restart restarts an application without building it, writing its unit
// first when it no longer describes it.
fn app_restart(lang: string, name: string) string {
    if !catalog_has(name) {
        return keeper_say1(lang, "common.no_such_application", "name", name)
    }
    if app_kind(app_path(name)) == "keeper" {
        return keeper_say(lang, "action.keeper_no_restart")
    }
    ignore_bool(app_install_unit(name))
    if !rho_path_exists(app_program(name)) {
        if job_start_built(name) == "" {
            return keeper_say1(lang, "common.busy_with_job", "name", name)
        }
        return keeper_say1(lang, "action.built_started", "name", name)
    }
    if app_systemd("restart\n" + app_unit_name(name) + "\n", "restart-" + name) != 0 {
        return keeper_say1(lang, "action.restart_failed", "name", name)
    }
    info("keeper", "restarted application " + name)
    keeper_event("app.restarted", name, name + " was restarted.")
    return keeper_say1(lang, "action.restarted", "name", name)
}

fn application_row_response(req: Request, name: string) Response {
    if !catalog_has(name) {
        return html(status_ok(), "")
    }
    return html(status_ok(), application_row_html(req, name, app_path(name), catalog_get(name, "origin")))
}

// application_action answers a row's button: the row again for htmx, the page
// with the message otherwise.
fn application_action(req: Request, name: string, message: string) Response {
    if htmx_is_request(req) {
        return application_row_response(req, name)
    }
    return applications_page_message(req, message)
}

fn applications_start(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    return application_action(req, name, app_start(keeper_lang(req), name))
}

fn applications_stop(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    return application_action(req, name, app_stop(keeper_lang(req), name))
}

fn applications_redeploy(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    return application_action(req, name, app_redeploy(keeper_lang(req), name))
}

fn applications_build(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    return application_action(req, name, app_build_job(keeper_lang(req), name))
}

fn applications_restart(req: Request) Response {
    if !keeper_allowed(req, "operate") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    return application_action(req, name, app_restart(keeper_lang(req), name))
}

// applications_uninstall takes an application out of the keeper: its service
// goes, and its catalogue record. Its files go only when the keeper fetched them
// itself; a checkout or a package is left where it is, and Install offers it
// again.
fn applications_uninstall(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let name: string = str_trim(form_field(request_body(req), "name"))
    if !catalog_has(name) {
        return applications_page_message(req, keeper_t1(req, "common.no_such_application", "name", name))
    }
    let path: string = app_path(name)
    if app_kind(path) == "keeper" {
        return applications_page_message(req, i18n_t(req, "apps.keeper_no_uninstall"))
    }
    let origin: string = catalog_get(name, "origin")
    app_remove_unit_of(name)
    app_remove_client(name)
    unpin(name)
    catalog_remove(name)
    // Its releases and its secrets go with it, so the same name installed again
    // starts with its own; its data is kept, which is a person's to remove.
    ignore_u32(rho_exec_args("rm", "-rf\n--\n" + app_home(name) + "\n", apps_report("uninstall-releases-" + name)))
    ignore_u32(rho_exec_args("rm", "-f\n--\n" + keeper_app_workspace(name) + "/app.env\n" + keeper_app_workspace(name) + "/app.secret\n",
        apps_report("uninstall-secrets-" + name)))
    var message: string = name + " was taken out of the keeper; its folder " + path + " was left alone."
    var shown: string = keeper_t2(req, "apps.uninstalled_kept", "name", name, "path", path)
    if rho_str_eq(origin, "fetched") && rho_str_starts_with(path, apps_home() + "/") {
        ignore_u32(rho_exec_args("rm", "-rf\n--\n" + path + "\n", apps_report("uninstall-" + name)))
        message = name + " was uninstalled and its folder removed."
        shown = keeper_t1(req, "apps.uninstalled_removed", "name", name)
    }
    info("keeper", "uninstalled application " + name)
    keeper_event("app.uninstalled", name, message)
    if mqtt_name() != "" {
        ignore_string(mqtt_write_files())
    }
    if htmx_is_request(req) {
        return html(status_ok(), "")
    }
    return applications_page_message(req, shown)
}

// applications_install adds an application: one found on the machine (`add`), a
// git URL, which is cloned under apps_home(), or a folder, which stays where it
// is. It is recorded in the catalogue, given a port and a unit, and started.
fn applications_install(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    var name: string = str_trim(form_field(body, "name"))
    let source: string = str_trim(form_field(body, "source"))
    let add: string = str_trim(form_field(body, "add"))
    let from_registry: string = str_trim(form_field(body, "package"))
    let add_to_menu: string = form_field(body, "menu")
    // The form carries the forms module's token: an install builds and runs what
    // it names, so it is accepted only from a page this keeper drew.
    if !forms_csrf_ok(body) {
        return applications_page_message(req, i18n_t(req, "apps.install.csrf"))
    }
    var path: string = ""
    var origin: string = ""
    if from_registry != "" {
        // name or name@version, from the Rho registry
        let at: i32 = rho_str_index_of(from_registry, "@")
        var wanted: string = ""
        name = from_registry
        if at > 0 {
            name = rho_str_slice(from_registry, 0, u32(at))
            wanted = rho_str_slice(from_registry, u32(at) + 1, u32(rho_strlen(from_registry)) - u32(at) - 1)
        }
        path = package_fetch(keeper_lang(req), name, wanted)
        if rho_str_starts_with(path, "!") {
            return applications_page_message(req, rho_str_slice(path, 1, u32(rho_strlen(path)) - 1))
        }
        origin = "registry"
    } else if add != "" {
        let candidates: string = catalog_candidates()
        path = record_path(candidates, add)
        if path == "" {
            return applications_page_message(req, keeper_t1(req, "apps.install.not_found", "name", add))
        }
        name = add
        origin = record_origin(candidates, add)
    } else {
        if source == "" {
            return applications_page_message(req, i18n_t(req, "apps.install.no_source"))
        }
        if !arg_ok(source) {
            return applications_page_message(req, i18n_t(req, "apps.install.bad_source"))
        }
        if source_is_git(source) {
            if name == "" {
                name = source_name(source)
            }
            if !valid_name(name) {
                return applications_page_message(req, i18n_t(req, "apps.install.bad_name"))
            }
            path = apps_home() + "/" + name
            if rho_path_exists(path) || catalog_has(name) {
                return applications_page_message(req, keeper_t1(req, "apps.install.already", "name", name))
            }
            ignore_u32(rho_exec_args("mkdir", "-p\n" + apps_home() + "\n", apps_report("mkdir-apps")))
            let log: string = apps_report("install-" + name)
            if rho_exec_args("git", "clone\n--\n" + source + "\n" + path + "\n", log) != 0 {
                ignore_u32(keeper_alert("ERROR", "Application " + name + " could not be installed", "app=" + name))
                return applications_page_message(req, keeper_t2(req, "apps.install.clone_failed", "source", source, "log", log))
            }
            origin = "fetched"
        } else {
            path = app_canonical(resolve_path(source))
            if !rho_path_exists(manifest_of(path)) {
                return applications_page_message(req, keeper_t1(req, "apps.install.no_manifest", "path", path))
            }
            if name == "" {
                name = yaml.value(manifest_of(path), "module.name")
            }
            origin = "external"
        }
    }
    if !valid_name(name) {
        return applications_page_message(req, i18n_t(req, "apps.install.bad_name"))
    }
    if catalog_has(name) {
        return applications_page_message(req, keeper_t2(req, "apps.install.already_at", "name", name, "path", app_path(name)))
    }
    if app_kind(path) != "keeper-hosted" {
        if rho_str_eq(origin, "fetched") {
            ignore_u32(rho_exec_args("rm", "-rf\n--\n" + path + "\n", apps_report("remove-not-hosted")))
        }
        return applications_page_message(req, keeper_t1(req, "apps.install.not_hosted", "path", path))
    }
    let port: string = catalog_put(name, origin, path)
    if add_to_menu == "1" || add_to_menu == "on" {
        pin(name)
    }
    info("keeper", "installed application " + name + " (" + origin + ") at " + path + " on port " + port)
    keeper_event("app.installed", name, name + " was installed from " + origin + ".")
    return applications_page_message(req, keeper_t1(req, "apps.installed", "name", name) + " " + app_start(keeper_lang(req), name))
}
