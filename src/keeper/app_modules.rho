module keeper.app_modules

// The keeper's application module registry.
//
// A module under modules/ is shared code with pages and storage of its own that
// applications include and compile in (inventory, rules, scheduler, …).
// modules/registry.yml is the installed set; this page confirms each path, and
// installs or removes one — never one an installed application still uses, and
// a folder only when the keeper fetched it. An application picks up a module
// change when it is rebuilt.

import std.web.http
import std.web.template
import rho.log

fn app_modules_root() string {
    return robohub_root() + "/modules"
}

fn app_modules_file() string {
    return app_modules_root() + "/registry.yml"
}

fn app_module_manifest(name: string, location: string) string {
    return app_modules_root() + "/" + location + "/module.yml"
}

fn app_module_entries() string {
    // Scan the modules directory for every module.yml, so the page lists all
    // installed modules rather than only those written into registry.yml.
    let dir: string = app_modules_root()
    if !rho_path_exists(dir) {
        return ""
    }
    let report: string = apps_report("list-modules")
    ignore_u32(rho_exec_args("ls", dir + "\n", report))
    var out: string = ""
    var rest: string = rho_read_text(report)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let name: string = ""
        if at < 0 {
            name = rest
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name == "" {
            continue
        }
        let path: string = dir + "/" + name
        if rho_path_exists(path + "/module.yml") {
            out = out + name + "|" + name + "|true\n"
        }
    }
    return out
}

fn app_module_add(name: string) bool {
    let path: string = app_modules_file()
    let text: string = rho_read_text(path)
    if rho_str_index_of(text, "  - name: " + name + "\n") >= 0 {
        return true
    }
    var out: string = text
    if rho_strlen(out) == 0 {
        out = "modules:\n"
    }
    out = out + "  - name: " + name + "\n    path: " + name + "\n    enabled: true\n"
    return rho_write_text(path, out)
}

fn app_module_remove_entry(name: string) bool {
    let path: string = app_modules_file()
    let text: string = rho_read_text(path)
    var out: string = ""
    var skip: bool = false
    var rest: string = text
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let trimmed: string = str_trim(line)
        if rho_str_index_of(trimmed, "- name:") == 0 {
            let found: string = unquote(rho_str_slice(trimmed, 7,
                u32(rho_strlen(trimmed)) - 7))
            skip = rho_str_eq(found, name)
        }
        if !skip {
            out = out + line + "\n"
        }
    }
    return rho_write_text(path, out)
}

fn app_module_title(manifest: string, name: string) string {
    var title: string = yaml.value(manifest, "module.title")
    if title == "" {
        title = yaml.value(manifest, "module_app.title")
    }
    if title == "" {
        title = yaml.value(manifest, "application.title")
    }
    if title == "" {
        title = yaml.value(manifest, "module.title")
    }
    if title == "" {
        title = name
    }
    return title
}

fn app_module_description(manifest: string) string {
    let description: string = yaml.value(manifest, "module_app.description")
    if description == "" {
        description = yaml.value(manifest, "module.description")
    }
    if description == ">" {
        description = ""
    }
    return description
}

fn app_module_actions(req: Request, name: string, location: string, enabled: bool) string {
    // A module can be included by more than one application, so there is no
    // single host to open from here. The registry lists the installed module;
    // the application that uses it serves its routes.
    return template_fill(template_get("app-module-actions"), i18n_vars(req) +
        vars("confirm_uninstall", i18n_t(req, "app_modules.uninstall_confirm")) + vars("name", name))
}

fn app_module_row_line(req: Request, line: string) string {
    let name: string = field(line, 0)
    let location: string = field(line, 1)
    let enabled: bool = rho_str_eq(field(line, 2), "true")
    let manifest: string = app_module_manifest(name, location)
    let present: bool = rho_path_exists(manifest)
    var title: string = name
    var description: string = i18n_t(req, "plugins.not_on_disk")
    var category: string = ""
    var version: string = ""
    if present {
        title = app_module_title(manifest, name)
        description = app_module_description(manifest)
        category = yaml.value(manifest, "module.category")
        if category == "" {
            category = yaml.value(manifest, "module_app.category")
        }
        version = yaml.value(manifest, "module.version")
    }
    return template_fill(template_get("app-module-row"),
        vars("name", name) +
        vars("title", title) +
        vars("category", category) +
        vars("description", description) +
        vars("version", version) +
        vars("status", app_module_status(req, present)) +
        vars("actions", app_module_actions(req, name, location, enabled)))
}

fn app_module_rows(req: Request) string {
    var out: string = ""
    var rest: string = app_module_entries()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" {
            out = out + app_module_row_line(req, line)
        }
    }
    if out == "" {
        out = "<tr><td colspan=\"7\">" + i18n_t(req, "app_modules.none") + "</td></tr>"
    }
    return out
}

fn app_module_status(req: Request, present: bool) string {
    var tone: string = "not-built"
    var label: string = i18n_t(req, "plugins.state_missing")
    if present {
        tone = "running"
        label = i18n_t(req, "plugins.state_installed")
    }
    return template_fill(template_get("status"), vars("tone", tone) + vars("label", label))
}

fn app_modules_page_message(req: Request, message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"), vars("message", message))
    }
    let body: string = template_fill(template_get("app-modules"), i18n_vars(req) +
        vars("notice", notice) + vars("rows", app_module_rows(req)) +
        vars("install_form", keeper_install_form(req, "/app-modules/install", "inventory", i18n_t(req, "app_modules.source_hint"), i18n_t(req, "app_modules.source_help"))))
    return page(req, i18n_t(req, "page.modules"), body)
}

fn app_modules_page(req: Request) Response {
    return app_modules_page_message(req, "")
}

fn app_modules_install(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return html(status_forbidden(), "<p>" + i18n_t(req, "plugins.csrf_nothing_installed") + "</p>")
    }
    var name: string = str_trim(form_field(body, "name"))
    let source: string = str_trim(form_field(body, "source"))
    if source == "" {
        return app_modules_page_message(req, i18n_t(req, "app_modules.name_one"))
    }
    if name == "" {
        name = plugin_source_name(source)
    }
    if !valid_name(name) {
        return app_modules_page_message(req, i18n_t(req, "app_modules.bad_name"))
    }
    let target: string = app_modules_root() + "/" + name
    if rho_path_exists(target) {
        return app_modules_page_message(req, keeper_t1(req, "plugins.already_installed", "name", name))
    }
    ignore_u32(rho_exec_args("mkdir", "-p\n" + app_modules_root() + "\n", apps_report("mkdir-micro-apps")))
    var code: u32 = 0
    if source_is_git(source) {
        code = rho_exec_args("git", "clone\n--\n" + source + "\n" + target + "\n",
            apps_report("install-module-" + name))
    } else {
        let path: string = resolve_path(source)
        if !rho_path_exists(path + "/module.yml") {
            return app_modules_page_message(req, keeper_t1(req, "app_modules.no_manifest", "path", path))
        }
        code = rho_exec_args("cp", "-r\n" + path + "\n" + target + "\n",
            apps_report("install-module-" + name))
    }
    if code != 0 {
        return app_modules_page_message(req, keeper_t1(req, "plugins.could_not_install", "source", source))
    }
    // A module says it is one: `module.type: module`.
    if yaml.value(target + "/module.yml", "module.type") != "module" {
        ignore_u32(rho_exec_args("rm", "-rf\n" + target + "\n",
            apps_report("remove-not-module")))
        return app_modules_page_message(req, keeper_t1(req, "app_modules.not_a_module", "source", source))
    }
    ignore_bool(app_module_add(name))
    info("keeper", "installed module " + name)
    return app_modules_page_message(req, keeper_t1(req, "providers.installed", "name", name))
}

// app_module_users is the installed applications whose manifest names a module —
// in `modules:` or among their dependencies — comma-separated, or "".
fn app_module_users(wanted: string) string {
    var out: string = ""
    var rest: string = catalog_names()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var app: string = rest
        if at < 0 { rest = "" } else { app = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        app = str_trim(app)
        if app == "" {
            continue
        }
        let manifest: string = "\n" + rho_read_text(app_canonical(catalog_get(app, "location")) + "/module.yml")
        if rho_str_index_of(manifest, "- name: " + wanted + "\n") >= 0 || rho_str_index_of(manifest, "\n    " + wanted + ":") >= 0 ||
            rho_str_index_of(manifest, "\n  " + wanted + ":") >= 0 {
            if out != "" {
                out = out + ", "
            }
            out = out + app
        }
    }
    return out
}

fn app_modules_uninstall(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    let name: string = str_trim(form_field(body, "name"))
    if !valid_name(name) {
        return app_modules_page_message(req, keeper_t1(req, "app_modules.no_such", "name", name))
    }
    let location: string = name
    var rest: string = app_module_entries()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_eq(field(line, 0), name) {
            location = field(line, 1)
        }
    }
    // A module is compiled into the applications that include it: removing one
    // they use would fail their next build. It is refused while any does.
    let users: string = app_module_users(name)
    if users != "" {
        return app_modules_page_message(req, keeper_t2(req, "app_modules.used_by", "name", name, "users", users))
    }
    let target: string = app_modules_root() + "/" + location
    ignore_bool(app_module_remove_entry(name))
    // Only a folder the keeper fetched is the keeper's to delete; a checkout a
    // person made is left where it is, and only unlisted.
    var message: string = keeper_t1(req, "plugins.uninstalled", "name", name)
    if fetched_by_keeper(target) {
        ignore_u32(rho_exec_args("rm", "-rf\n--\n" + target + "\n",
            apps_report("uninstall-module-" + name)))
        fetched_set(target, false)
    } else {
        message = keeper_t1(req, "app_modules.unlisted", "name", name)
    }
    info("keeper", "uninstalled module " + name)
    if htmx_is_request(req) {
        return html(status_ok(), "")
    }
    return app_modules_page_message(req, message)
}
