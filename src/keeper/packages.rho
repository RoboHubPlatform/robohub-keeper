//
// @file packages.rho
// @brief Applications published to the Rho registry: installing one, and updating it when a newer version is out.
//
// @module keeper.packages
// @project keeper
// @author Aurel Miron
// @date 2026-11-13
//
// SPDX-License-Identifier: MIT
