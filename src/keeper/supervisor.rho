module keeper.supervisor

// Running what the catalogue holds, through systemd.
//
// Each application is a user unit the keeper writes from its manifest and its
// catalogue record — no script in between — and reads back through systemd: is it
// active, has it failed, what did it print. The environment an application is
// started with is written once, to `app.env` in its workspace, and the unit names
// that file, so the unit and what the keeper believes about the application
// cannot disagree.
//
// The environment contract — what a started application is told:
//
//   RHO_APP_NAME            its name in the catalogue
//   RHO_APP_WORKSPACE       the folder its state lives in (ROBOHUB_APP_WORKSPACE too, for now)
//   RHO_HTTP_ADDR           where to listen: 127.0.0.1:<port>, or :<port> for deploy.listen: lan
//   RHO_APP_SECRET          a random value of its own, the seed its forms' CSRF tokens use
//   RHO_AUTH_URL            the issuer that signs people in
//   ROBOHUB_KEEPER_URL      the keeper, for its API
//   RHO_CLIENT_ID, RHO_CLIENT_SECRET_FILE, RHO_SERVICE_<NAME>_URL
//                           when it calls other services (deploy.calls)
//
// ROBOHUB_ROOT, ROBOHUB_WORKSPACE, ROBOHUB_APP_MANIFEST and RHO_KEEPER_PORT are
// still written for applications that read the orchestrator's files; they go when
// every application asks the keeper's API instead.

import std.web.http

fn keeper_app_workspace(name: string) string {
    return keeper_state_dir() + "/workspaces/" + name
}

// An application built from a folder runs from a release the keeper made of the
// build, never from the folder: ~/.rho/keeper/apps/<name>/releases/<version>-<time>
// holds the program, its manifest and the files it reads at run time (static/,
// and what deploy.files names), and `current` is a link to the release in use.
// A rebuild in the folder changes nothing until the next redeploy; the three
// newest releases are kept, so a rollback is one link moved back.

fn app_home(name: string) string {
    return keeper_state_dir() + "/apps/" + name
}

fn app_current(name: string) string {
    return app_home(name) + "/current"
}

// app_released says whether an application runs from releases: one built from a
// folder (a published package runs as it was installed; an integration runs its
// service's own program).
fn app_released(name: string) bool {
    return !integration_is(name) && !rho_str_eq(catalog_get(name, "origin"), "registry")
}

// app_release_lines is the shell that makes a release of a finished build and
// puts it in use: the program, the manifest, static/ and deploy.files, copied
// into a new release; `current` switched to it in one rename; the oldest beyond
// three removed.
// @req KEEP-APPS-0009
fn app_release_lines(name: string) string {
    if !app_released(name) {
        return ""
    }
    let location: string = app_canonical(catalog_get(name, "location"))
    let command: string = app_command(name, location)
    var version: string = app_version(location)
    if version == "" {
        version = "0"
    }
    var files: string = "static\n" + app_manifest_list(location, "deploy.files")
    var copies: string = ""
    while files != "" {
        let at: i32 = rho_str_index_of(files, "\n")
        var one: string = files
        if at < 0 { files = "" } else { one = rho_str_slice(files, 0, u32(at)); files = rho_str_slice(files, u32(at) + 1, u32(rho_strlen(files)) - u32(at) - 1) }
        let file: string = str_trim(one)
        if file != "" && !rho_str_starts_with(file, "/") && rho_str_index_of(file, "..") < 0 {
            copies = copies + "if [ -e " + shell_quote(file) + " ]; then cp -a " + shell_quote(file) + " \"$REL/\" || finish failed \"" +
                file + " could not be copied into the release\"; fi\n"
        }
    }
    let home: string = shell_quote(app_home(name))
    return "echo \"Making a release of " + name + " " + version + " …\"\n" +
        "cd " + shell_quote(location) + " || finish failed \"the folder is gone\"\n" +
        "REL=" + home + "/releases/" + shell_quote(version) + "-$(date +%Y%m%d%H%M%S)\n" +
        "mkdir -p \"$REL\" || finish failed \"the release could not be made\"\n" +
        "cp -a " + shell_quote("build/" + command) + " \"$REL/\" || finish failed \"the program could not be copied into the release\"\n" +
        "cp -a module.yml \"$REL/\" || finish failed \"the manifest could not be copied into the release\"\n" +
        copies +
        // The release in use before this one, kept so a release that does not
        // answer can be taken back out of use (job_health_or_back).
        "PREV=$(readlink " + home + "/current 2>/dev/null || true)\n" +
        "ln -sfn \"$REL\" " + home + "/current.next && mv -T " + home + "/current.next " + home + "/current || finish failed \"the release could not be put in use\"\n" +
        "echo \"Release $(basename \"$REL\") is in use.\"\n" +
        // Three are kept, by when they were made (the time in their name), and
        // never the one in use or the one before it.
        app_releases_by_time(home) + " | tail -n +4 | while read old; do " +
        "[ \"" + "$(readlink " + home + "/current)\" = \"" + "$old\" ] || [ \"$PREV\" = \"$old\" ] || rm -rf -- \"$old\"; done\n"
}

// app_releases_by_time is the shell that lists an application's release folders,
// newest first by the time in their names (`<version>-<YYYYmmddHHMMSS>`), which
// no `touch` or copy changes.
fn app_releases_by_time(home: string) string {
    return "ls -1d " + home + "/releases/*/ 2>/dev/null | sed 's:/$::' | awk -F- '{print $NF\" \"$0}' | sort -r | cut -d' ' -f2-"
}

// app_releases are an application's releases, newest first, one per line.
fn app_releases(name: string) string {
    let report: string = apps_report("releases-" + name)
    if rho_exec_args("sh", "-c\nls -1t " + shell_quote(app_home(name) + "/releases") + " 2>/dev/null\n", report) != 0 {
        return ""
    }
    return rho_read_text(report)
}

// app_release_in_use is the release `current` points at, by name, or "".
fn app_release_in_use(name: string) string {
    let report: string = apps_report("release-" + name)
    if rho_exec_args("sh", "-c\nbasename \"$(readlink " + shell_quote(app_current(name)) + ")\"\n", report) != 0 {
        return ""
    }
    let text: string = str_trim(rho_read_text(report))
    if rho_str_eq(text, ".") || rho_str_eq(text, "current") {
        return ""
    }
    return text
}

fn app_env_path(name: string) string {
    return keeper_app_workspace(name) + "/app.env"
}

fn app_unit_name(name: string) string {
    let unit: string = catalog_get(name, "unit")
    if unit == "" {
        return name
    }
    return unit
}

fn app_unit_file(name: string) string {
    return getenv("HOME") + "/.config/systemd/user/" + app_unit_name(name) + ".service"
}

// app_port_of is the port an application serves on: the one the catalogue gave
// it, or its manifest's for one not in the catalogue.
fn app_port_of(name: string) string {
    if app_kind(catalog_get(name, "location")) == "keeper" {
        return keeper_listen_port()
    }
    let port: string = catalog_get(name, "port")
    if port != "" {
        return port
    }
    let location: string = catalog_get(name, "location")
    if location == "" {
        return ""
    }
    return app_port(location)
}

// app_listen_host is where an application listens: this machine only, like the
// keeper — which is also the address the machine's own browser is forwarded to
// under WSL — unless its manifest says `deploy.listen: lan`, for an application
// devices on the network have to reach.
// @req KEEP-0006
fn app_listen_host(location: string) string {
    if rho_str_eq(yaml.value(manifest_of(location), "deploy.listen"), "lan") {
        return ""
    }
    return "127.0.0.1"
}

fn keeper_url() string {
    return "http://127.0.0.1:" + keeper_listen_port()
}

// app_secret is the application's own random value, made once and kept in its
// workspace.
fn app_secret(name: string) string {
    let file: string = keeper_app_workspace(name) + "/auth/app.secret"
    let existing: string = str_trim(rho_read_text(file))
    if rho_strlen(existing) >= 32 {
        return existing
    }
    let value: string = rho_random_hex(32)
    ignore_u32(rho_exec_args("mkdir", "-p\n" + keeper_app_workspace(name) + "/auth\n", apps_report("mkdir-workspace")))
    ignore_bool(rho_write_secret(file, value + "\n"))
    return value
}

// env_quote is a value as systemd's environment file reads it whole: in double
// quotes, with a quote or a backslash in it escaped. Unquoted, a value stops at
// its first space — a PATH holding `/mnt/c/Program Files/...`, as WSL's does,
// lost every directory after it, and with them powershell.exe.
fn env_quote(value: string) string {
    var out: string = "\""
    var i: u32 = 0
    while i < u32(rho_strlen(value)) {
        let ch: string = rho_str_slice(value, i, 1)
        if rho_str_eq(ch, "\"") || rho_str_eq(ch, "\\") {
            out = out + "\\"
        }
        out = out + ch
        i = i + 1
    }
    return out + "\""
}

// app_environment is the contract above for one application, as KEY=value lines.
// @req KEEP-APPS-0005
fn app_environment(name: string) string {
    let location: string = catalog_get(name, "location")
    let workspace: string = keeper_app_workspace(name)
    var out: string = "RHO_APP_NAME=" + name + "\n" +
        "RHO_APP_WORKSPACE=" + workspace + "\n" +
        "ROBOHUB_APP_WORKSPACE=" + workspace + "\n" +
        "RHO_HTTP_ADDR=" + app_listen_host(location) + ":" + app_port_of(name) + "\n" +
        "RHO_APP_SECRET=" + app_secret(name) + "\n" +
        "RHO_AUTH_URL=" + keeper_url() + "\n" +
        "ROBOHUB_KEEPER_URL=" + keeper_url() + "\n" +
        "RHO_KEEPER_PORT=" + keeper_listen_port() + "\n" +
        "ROBOHUB_APP_MANIFEST=" + app_manifest_in_use(name) + "\n" +
        "HOME=" + env_quote(getenv("HOME")) + "\n" +
        "PATH=" + env_quote(getenv("PATH")) + "\n" + bus_environment(name)
    let root: string = robohub_root()
    if rho_path_exists(root + "/registry/modules") {
        let canonical: string = app_canonical(root)
        out = out + "ROBOHUB_ROOT=" + canonical + "\nROBOHUB_WORKSPACE=" + dir_of(canonical) + "\n"
    }
    // Every application is a client of the keeper — it may read the keeper's API
    // — and of the services it calls; it is told who it is and where they are.
    let secret_file: string = app_provision_client(name, location)
    if secret_file != "" {
        out = out + "RHO_CLIENT_ID=" + name + "\nRHO_CLIENT_SECRET_FILE=" + secret_file + "\n"
        var rest: string = app_calls(location)
        while rest != "" {
            let at: i32 = rho_str_index_of(rest, "\n")
            var call: string = rest
            if at < 0 { rest = "" } else { call = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
            let colon: i32 = rho_str_index_of(call, ":")
            var service: string = call
            if colon >= 0 { service = rho_str_slice(call, 0, u32(colon)) }
            if service != "" && auth_safe_name(service) && app_port_of(service) != "" {
                out = out + "RHO_SERVICE_" + app_env_name(service) + "_URL=http://127.0.0.1:" + app_port_of(service) + "\n"
            }
        }
    }
    return out
}

fn app_write_environment(name: string) void {
    ignore_u32(rho_exec_args("mkdir", "-p\n" + keeper_app_workspace(name) + "\n", apps_report("mkdir-workspace")))
    ignore_u32(rho_exec_args("chmod", "700\n" + keeper_app_workspace(name) + "\n", apps_report("chmod-workspace")))
    ignore_bool(rho_write_secret(app_env_path(name), app_environment(name)))
}

// app_program is what the unit runs: a published package's own program, or the
// program of the release in use.
fn app_program(name: string) string {
    if integration_is(name) {
        return integration_program(name)
    }
    let location: string = app_canonical(catalog_get(name, "location"))
    let command: string = app_command(name, location)
    if rho_str_eq(catalog_get(name, "origin"), "registry") {
        return location + "/" + command
    }
    return app_current(name) + "/" + command
}

// app_built is what a build of the folder made, before any release of it.
fn app_built(name: string) string {
    let location: string = app_canonical(catalog_get(name, "location"))
    return location + "/build/" + app_command(name, location)
}

// app_manifest_in_use is the manifest of what runs: the release's copy, or the
// folder's while there is no release yet.
fn app_manifest_in_use(name: string) string {
    if app_released(name) && rho_path_exists(app_current(name) + "/module.yml") {
        return app_current(name) + "/module.yml"
    }
    return app_canonical(catalog_get(name, "location")) + "/module.yml"
}

// app_run_dir is where the unit runs the application from: the release in use,
// or, for a published package, its own folder.
fn app_run_dir(name: string) string {
    if app_released(name) {
        return app_current(name)
    }
    return app_canonical(catalog_get(name, "location"))
}

// app_unit_description is the unit's description: the application's title,
// named as RoboHub's once.
fn app_unit_description(name: string, location: string) string {
    let title: string = app_title(name, location)
    if rho_str_starts_with(title, "RoboHub") {
        return title
    }
    return "RoboHub " + title
}

// app_unit_text is the unit the keeper writes for an application. It starts after
// the applications it depends on (deploy.depends), and wants them; systemd
// restarts it whenever it ends without being stopped, for ever, kills it when it
// will not stop, watches it when its program can say it is alive, and bounds
// what it may use (robohub ADR-0018).
// @req KEEP-APPS-0004, KEEP-APPS-0017, KEEP-APPS-0018, KEEP-APPS-0019
fn app_unit_text(name: string) string {
    if integration_is(name) {
        // An integration runs its service's own program with the configuration
        // the keeper wrote, from its own folder; it is told nothing else.
        let path: string = catalog_get(name, "location")
        return "# Written by the RoboHub keeper for the integration " + name + " (" + path + ").\n" +
            "# The keeper writes it again when the integration changes; edits here are lost.\n" +
            "[Unit]\nDescription=" + app_unit_description(name, path) + "\nAfter=network-online.target\n" + unit_start_limit() + "\n" +
            "[Service]\nType=simple\nWorkingDirectory=" + integration_dir(name) + "\n" +
            "ExecStart=" + integration_command_line(name) + "\n" +
            "ExecReload=/bin/kill -HUP $MAINPID\n" + unit_restart_policy() + "\n[Install]\nWantedBy=default.target\n"
    }
    let location: string = app_canonical(catalog_get(name, "location"))
    var after: string = "network-online.target"
    var wants: string = ""
    var rest: string = app_depends(name, location)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var dep: string = rest
        if at < 0 { rest = "" } else { dep = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        if dep != "" && !rho_str_eq(dep, name) && catalog_has(dep) {
            after = after + " " + app_unit_name(dep) + ".service"
            wants = wants + " " + app_unit_name(dep) + ".service"
        }
    }
    var unit: string = "# Written by the RoboHub keeper from " + location + "/module.yml.\n" +
        "# The keeper writes it again when the application changes; edits here are lost.\n" +
        "[Unit]\nDescription=" + app_unit_description(name, location) + "\nAfter=" + after + "\n"
    if wants != "" {
        unit = unit + "Wants=" + str_trim(wants) + "\n"
    }
    return unit + unit_start_limit() + "\n[Service]\n" + unit_type_lines(app_program_notifies(name)) +
        "WorkingDirectory=" + app_run_dir(name) + "\n" +
        "EnvironmentFile=" + app_env_path(name) + "\n" +
        "ExecStart=" + app_program(name) + "\n" + app_isolation(name) + unit_restart_policy() +
        limit_lines(app_limit(location, "memory"), app_limit(location, "tasks"), app_limit(location, "cpu_weight")) +
        "\n[Install]\nWantedBy=default.target\n"
}

// app_program_notifies is whether the program an application's unit runs can
// tell systemd it is ready and alive: its file carries the marker rho puts in
// every server that does. The file is read and searched here; nothing is run.
// @req KEEP-APPS-0018
fn app_program_notifies(name: string) bool {
    if integration_is(name) {
        return false
    }
    return program_has_marker(rho_read_text(app_program(name)))
}

// app_type_dropin is the drop-in beside an application's unit that a job writes
// when it puts a release in use (app_type_fit_lines).
fn app_type_dropin(name: string) string {
    return getenv("HOME") + "/.config/systemd/user/" + app_unit_name(name) + ".service.d/keeper-type.conf"
}

// app_type_fit_lines is the shell a job runs once it has moved `current`: the
// unit was written for the program in use before, so a drop-in says how systemd
// follows the program now in use — watched when it carries the marker, a plain
// process when not (a rollback to a release built before rho 0.20 would
// otherwise wait for a READY=1 that never comes). The marker is looked for in
// the keeper's own release path, never in anything a request carried.
// @req KEEP-APPS-0018
fn app_type_fit_lines(name: string) string {
    if !app_released(name) {
        return ""
    }
    let location: string = app_canonical(catalog_get(name, "location"))
    let program: string = shell_quote(app_current(name) + "/" + app_command(name, location))
    let dropin: string = shell_quote(app_type_dropin(name))
    return "mkdir -p " + shell_quote(dir_of(app_type_dropin(name))) + "\n" +
        "if grep -qaF -- " + SD_NOTIFY_MARKER + " " + program + "; then printf '%s' " + shell_quote(unit_type_dropin(true)) + " > " + dropin +
        "; else printf '%s' " + shell_quote(unit_type_dropin(false)) + " > " + dropin + "; fi\n" +
        "systemctl --user daemon-reload || true\n"
}

// app_limit is one resource limit of an application: what its manifest says
// under `deploy.limits` (a block, or `{memory: 4G, tasks: 4096}` on one line),
// or the default when it says nothing or says something that is not a limit.
// @req KEEP-APPS-0019
fn app_limit(location: string, key: string) string {
    let value: string = app_limit_declared(location, key)
    if value != "" && limit_problem(key, value) == "" {
        return value
    }
    if rho_str_eq(key, "memory") {
        return LIMIT_MEMORY_DEFAULT
    }
    if rho_str_eq(key, "tasks") {
        return LIMIT_TASKS_DEFAULT
    }
    return LIMIT_CPU_WEIGHT_DEFAULT
}

// app_limit_declared is what a manifest says of one limit, as written, or "".
fn app_limit_declared(location: string, key: string) string {
    let manifest: string = manifest_of(location)
    let value: string = unquote(str_trim(yaml.value(manifest, "deploy.limits." + key)))
    if value != "" {
        return value
    }
    return limit_flow_value(yaml.value(manifest, "deploy.limits"), key)
}

// app_limit_problems is why the limits a manifest declares were refused, one per
// line (`deploy.limits.memory: memory is a size such as 512M or 2G`), or "".
// @req KEEP-APPS-0019
fn app_limit_problems(location: string) string {
    var out: string = ""
    var keys: string = "memory\ntasks\ncpu_weight\n"
    while keys != "" {
        let at: i32 = rho_str_index_of(keys, "\n")
        let key: string = rho_str_slice(keys, 0, u32(at))
        keys = rho_str_slice(keys, u32(at) + 1, u32(rho_strlen(keys)) - u32(at) - 1)
        let value: string = app_limit_declared(location, key)
        if value != "" && limit_problem(key, value) != "" {
            out = out + "deploy.limits." + key + " = " + value + ": " + limit_problem(key, value) + "\n"
        }
    }
    return out
}

// limits_enforced is whether this machine bounds a unit's resources: the unified
// cgroup hierarchy (v2) with the memory controller. On cgroup v1 — WSL's, among
// others — a user unit's limits are written and ignored.
// @req KEEP-APPS-0019
fn limits_enforced() bool {
    var file: string = getenv("RHO_KEEPER_CGROUP_CONTROLLERS")
    if file == "" {
        file = "/sys/fs/cgroup/cgroup.controllers"
    }
    return rho_path_exists(file) && cgroup_v2_enforces(rho_read_text(file))
}

// app_isolation is what keeps a hosted application out of the keeper's and the
// other applications' secrets, though they all run as one user: the keeper's
// folder is an empty read-only one in the application's view, with only its own
// workspace and its own releases put back, and the
// keys that mint tokens are hidden. NoNewPrivileges always applies; the paths
// only where the machine's systemd can make a private view for a user service,
// which the keeper tries once (app_isolation_works) — a unit that cannot start
// would be worse than one that shares a folder.
// @req KEEP-0006
fn app_isolation(name: string) string {
    var out: string = "NoNewPrivileges=yes\n"
    if integration_is(name) || !app_isolation_works() {
        return out
    }
    let auth: string = auth_dir()
    // A user manager makes the private view inside a user namespace: without
    // PrivateUsers= systemd 249 cannot set up the mount namespace for a user
    // service ("Operation not supported", status 226/NAMESPACE). Supplementary
    // groups — dialout for a serial port — keep working, unmapped.
    return out + "PrivateUsers=yes\nTemporaryFileSystem=" + keeper_state_dir() + ":ro\n" +
        "BindPaths=" + keeper_app_workspace(name) + " -" + app_home(name) + "\n" +
        "InaccessiblePaths=-" + auth + "/private.pem -" + auth + "/signing.key -" + auth + "/master.token -" +
        auth + "/credentials.json -" + auth + "/clients\n"
}

// app_isolation_works is whether this machine's systemd can give a user service
// a private view of the file system: asked once of a throwaway unit with the
// same settings, which the keeper writes and starts through `systemctl --user`
// (no D-Bus needed, unlike systemd-run), and the answer kept. A `no` the old
// systemd-run probe kept is asked again, once (isolation_kept).
// @req KEEP-0006, KEEP-APPS-0021
fn app_isolation_works() bool {
    let kept: string = keeper_state_dir() + "/isolation.txt"
    let said: string = isolation_kept(rho_read_text(kept))
    if rho_str_eq(said, "yes") {
        return true
    }
    if rho_str_eq(said, "no") {
        return false
    }
    rho_lock("keeper.isolation-probe")
    let again: string = isolation_kept(rho_read_text(kept))
    if !rho_str_eq(again, "ask") {
        rho_unlock("keeper.isolation-probe")
        return rho_str_eq(again, "yes")
    }
    let unit: string = "rh-keeper-isolation-probe.service"
    let dir: string = getenv("HOME") + "/.config/systemd/user"
    ignore_u32(rho_exec_args("mkdir", "-p\n" + dir + "\n", apps_report("mkdir-units")))
    ignore_bool(rho_write_text(dir + "/" + unit, isolation_probe_unit(keeper_state_dir(), auth_dir())))
    ignore_u32(app_systemd("daemon-reload\n", "daemon-reload"))
    // The exit status is the answer: a oneshot start returns when /bin/true has
    // run in the view, or fails when systemd could not make it.
    let code: u32 = app_systemd("start\n" + unit + "\n", "isolation-probe")
    if code != 0 {
        ignore_u32(app_systemd("reset-failed\n" + unit + "\n", "isolation-probe-reset"))
    }
    ignore_u32(rho_exec_args("rm", "-f\n--\n" + dir + "/" + unit + "\n", apps_report("isolation-probe-rm")))
    ignore_u32(app_systemd("daemon-reload\n", "daemon-reload"))
    var answer: string = "no-v3"
    if code == 0 {
        answer = "yes-v3"
    }
    ignore_bool(rho_write_text(kept, answer + "\n"))
    rho_unlock("keeper.isolation-probe")
    info("keeper", "user-service isolation: " + answer)
    return code == 0
}

fn app_systemd(args: string, report: string) u32 {
    return rho_exec_args("systemctl", "--user\n" + args, apps_report(report))
}

// app_install_unit writes the environment and the unit, and tells systemd. It
// answers whether the unit changed, which is when a running application has to be
// restarted to run as it now says.
fn app_install_unit(name: string) bool {
    if integration_is(name) {
        if rho_str_eq(name, mqtt_name()) {
            ignore_string(mqtt_write_files())
        }
    } else {
        app_write_environment(name)
        // An application that binds the bus is a broker user: the broker learns of
        // it before it starts.
        if mqtt_name() != "" && app_binds_bus(catalog_get(name, "location")) {
            ignore_string(mqtt_write_files())
        }
    }
    let text: string = app_unit_text(name)
    // A drop-in a job wrote for the release it put in use is folded into the
    // unit, which is now written for the program in use (app_type_fit_lines).
    var dropped: bool = false
    if rho_path_exists(app_type_dropin(name)) {
        ignore_u32(rho_exec_args("rm", "-f\n--\n" + app_type_dropin(name) + "\n", apps_report("type-dropin-rm")))
        dropped = true
    }
    if rho_str_eq(rho_read_text(app_unit_file(name)), text) {
        if dropped {
            ignore_u32(app_systemd("daemon-reload\n", "daemon-reload"))
        }
        return dropped
    }
    ignore_u32(rho_exec_args("mkdir", "-p\n" + getenv("HOME") + "/.config/systemd/user\n", apps_report("mkdir-units")))
    ignore_bool(rho_write_text(app_unit_file(name), text))
    ignore_u32(app_systemd("daemon-reload\n", "daemon-reload"))
    ignore_u32(app_systemd("enable\n" + app_unit_name(name) + "\n", "enable-" + name))
    ignore_u32(rho_exec_args("loginctl", "enable-linger\n" + getenv("USER") + "\n", apps_report("linger")))
    info("keeper", "wrote the service unit of " + name)
    return true
}

fn app_remove_unit_of(name: string) void {
    if !rho_path_exists(app_unit_file(name)) {
        return
    }
    ignore_u32(app_systemd("disable\n--now\n" + app_unit_name(name) + "\n", "disable-" + name))
    ignore_u32(rho_exec_args("rm", "-f\n" + app_unit_file(name) + "\n", apps_report("remove-unit-" + name)))
    ignore_u32(rho_exec_args("rm", "-rf\n--\n" + dir_of(app_type_dropin(name)) + "\n", apps_report("remove-unit-" + name)))
    ignore_u32(app_systemd("daemon-reload\n", "daemon-reload"))
}

// app_active is what systemd says of the unit: active, activating, deactivating,
// inactive, failed — or "none" when there is no unit.
fn app_active(name: string) string {
    if !rho_path_exists(app_unit_file(name)) {
        return "none"
    }
    let report: string = "is-active-" + name
    ignore_u32(app_systemd("is-active\n" + app_unit_name(name) + "\n", report))
    let state: string = first_line(rho_read_text(apps_report(report)))
    if state == "" {
        return "inactive"
    }
    return state
}

// app_healthy is whether the application answers its health probe. Every Rho
// server answers /healthz; one that does not is asked for its first page.
fn app_healthy(name: string) bool {
    let port: string = app_port_of(name)
    if port == "" {
        return false
    }
    if integration_is(name) {
        return tcp_answers(port)
    }
    if port_answers(port, "/healthz") {
        return true
    }
    return port_answers(port, app_route(catalog_get(name, "location")))
}

// app_state is one word for what an application is doing:
//   running      active and answering
//   starting     active or activating, not answering yet
//   failed       systemd gave up on it, or it keeps restarting
//   stopped      a unit that is not running
//   not-built    a folder whose program has not been built
//   not-deployed no unit yet
//   keeper       the keeper itself
// @req KEEP-APPS-0006
fn app_state(name: string) string {
    let location: string = catalog_get(name, "location")
    if app_kind(location) == "keeper" {
        return "keeper"
    }
    let active: string = app_active(name)
    if rho_str_eq(active, "active") {
        if app_healthy(name) {
            return "running"
        }
        return "starting"
    }
    if rho_str_eq(active, "activating") || rho_str_eq(active, "reloading") {
        return "starting"
    }
    if rho_str_eq(active, "failed") {
        return "failed"
    }
    if !rho_path_exists(app_program(name)) {
        return "not-built"
    }
    if rho_str_eq(active, "none") {
        // Started some other way, by hand or by an older keeper.
        if app_healthy(name) {
            return "running"
        }
        return "not-deployed"
    }
    return "stopped"
}

// app_journal is the application's last lines from the journal.
// @req KEEP-0015
fn app_journal(name: string, lines: u32) string {
    let report: string = apps_report("journal-" + name)
    ignore_u32(rho_exec_args("journalctl", "--user\n-u\n" + app_unit_name(name) + ".service\n-n\n" +
        rho_int_to_str(lines) + "\n--no-pager\n-o\nshort-iso\n", report))
    return rho_read_text(report)
}
