module keeper.plugins

// The keeper's plugin registry.
//
// Two lists. The alert channels are the providers of the alert interface the
// keeper's module.yml binds: this page switches one on or off and sends a test
// through it, both through the interface. The plugins are Rho modules under the
// ecosystem's plugins/ directory: this page lists what is installed and what the
// keeper has enabled, and installs or removes one. Either change is this
// installation's only, so a source-controlled default is not edited by a
// dashboard.

import std.web.http
import std.web.template
import rho.log

fn plugin_state_set(name: string, enabled: string) void {
    let file: string = keeper_plugin_state_file()
    let text: string = rho_read_text(file)
    var out: string = ""
    var rest: string = text
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        let line: string = ""
        if at < 0 {
            line = rest
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        let equals: i32 = rho_str_index_of(line, "=")
        if equals >= 0 && rho_str_eq(rho_str_slice(line, 0, u32(equals)), name) {
            continue
        }
        out = out + line + "\n"
    }
    out = out + name + "=" + enabled + "\n"
    ignore_bool(rho_write_text(file, out))
}

fn plugin_action_forms(req: Request, name: string, enabled: bool) string {
    var enabled_flag: string = ""
    if enabled {
        enabled_flag = "true"
    }
    return template_fill(template_get("plugin-actions"), i18n_vars(req) +
        vars("confirm_uninstall", i18n_t(req, "plugins.uninstall_confirm")) +
        vars("name", name) +
        vars("enabled", enabled_flag))
}

fn plugin_row_line(req: Request, line: string) string {
    let name: string = field(line, 0)
    let enabled: bool = keeper_plugin_enabled(name)
    var status: string = plugin_status("stopped", i18n_t(req, "plugins.state_disabled"))
    if enabled {
        status = plugin_status("running", i18n_t(req, "plugins.state_enabled"))
    }
    var summary: string = field(line, 3)
    if field(line, 5) == "false" {
        status = plugin_status("not-built", i18n_t(req, "plugins.state_missing"))
        summary = i18n_t(req, "plugins.not_on_disk")
    }
    return template_fill(template_get("plugin-row"),
        vars("name", name) +
        vars("kind", field(line, 1)) +
        vars("transport", field(line, 2)) +
        vars("summary", summary) +
        vars("status", status) +
        vars("actions", plugin_action_forms(req, name, enabled)))
}

fn plugin_row_html(req: Request, name: string) string {
    var rest: string = plugin_rows(plugin_root())
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if field(line, 0) == name {
            return plugin_row_line(req, line)
        }
    }
    return ""
}

fn plugin_rows_html(req: Request) string {
    var out: string = ""
    var rest: string = plugin_rows(plugin_root())
    while rho_strlen(rest) > 0 {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" {
            out = out + plugin_row_line(req, line)
        }
    }
    if out == "" {
        out = "<tr><td colspan=\"6\">" + i18n_t(req, "plugins.none") + "</td></tr>"
    }
    return out
}

fn channel_row_html(req: Request, name: string) string {
    let enabled: bool = alert.enabled(name)
    var enabled_flag: string = ""
    var status: string = plugin_status("stopped", i18n_t(req, "plugins.state_disabled"))
    if enabled {
        enabled_flag = "true"
        status = plugin_status("running", i18n_t(req, "plugins.state_enabled"))
    }
    var threshold: string = alert.config(name, "severity_threshold")
    if threshold == "" {
        threshold = "INFO"
    }
    return template_fill(template_get("channel-row"),
        vars("name", name) +
        vars("threshold", threshold) +
        vars("threshold_label", keeper_t1(req, "plugins.channel_from", "threshold", threshold)) +
        vars("status", status) +
        vars("actions", template_fill(template_get("channel-actions"),
            i18n_vars(req) + vars("name", name) + vars("enabled", enabled_flag))))
}

fn channel_rows_html(req: Request) string {
    var out: string = ""
    var rest: string = alert.providers()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 {
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name != "" {
            out = out + channel_row_html(req, name)
        }
    }
    if out == "" {
        out = "<tr><td colspan=\"4\">" + i18n_t(req, "plugins.no_channel") + "</td></tr>"
    }
    return out
}

fn plugin_status(tone: string, label: string) string {
    return template_fill(template_get("status"), vars("tone", tone) + vars("label", label))
}

fn plugins_page_message(req: Request, message: string) Response {
    let notice: string = ""
    if message != "" {
        notice = template_fill(template_get("notice"), vars("message", message))
    }
    let body: string = template_fill(template_get("plugins"), i18n_vars(req) +
        vars("notice", notice) + vars("channels", channel_rows_html(req)) +
        vars("rows", plugin_rows_html(req)) +
        vars("root", plugin_root()) + vars("install_form", keeper_install_form(req, "/plugins/install", "robohub-auth", i18n_t(req, "plugins.source_hint"), i18n_t(req, "plugins.source_help"))))
    return page(req, i18n_t(req, "page.plugins"), body)
}

fn plugins_page(req: Request) Response {
    return plugins_page_message(req, "")
}

fn plugins_toggle(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    let name: string = str_trim(form_field(body, "name"))
    let enabled: string = form_field(body, "enabled")
    if keeper_alert_bound(name) {
        var value: string = "true"
        if enabled == "0" {
            value = "false"
        }
        if !alert.configure(name, "enabled", value) {
            return plugins_page_message(req, keeper_t1(req, "plugins.setting_not_saved", "name", name))
        }
        info("keeper", "alert channel " + name + " enabled=" + value)
        if htmx_is_request(req) {
            return html(status_ok(), channel_row_html(req, name))
        }
        if value == "false" {
            return plugins_page_message(req, keeper_t1(req, "plugins.channel_disabled", "name", name))
        }
        return plugins_page_message(req, keeper_t1(req, "plugins.channel_enabled", "name", name))
    }
    if !valid_name(name) || !rho_path_exists(plugin_manifest(plugin_root(), name)) {
        return plugins_page_message(req, keeper_t1(req, "plugins.no_such", "name", name))
    }
    plugin_state_set(name, enabled)
    if enabled == "0" {
        info("keeper", "disabled plugin " + name)
        if htmx_is_request(req) {
            return html(status_ok(), plugin_row_html(req, name))
        }
        return plugins_page_message(req, keeper_t1(req, "plugins.channel_disabled", "name", name))
    }
    info("keeper", "enabled plugin " + name)
    if htmx_is_request(req) {
        return html(status_ok(), plugin_row_html(req, name))
    }
    return plugins_page_message(req, keeper_t1(req, "plugins.channel_enabled", "name", name))
}

fn plugins_test(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    let name: string = str_trim(form_field(body, "name"))
    if !keeper_alert_bound(name) {
        return plugins_page_message(req, keeper_t1(req, "plugins.no_such_channel", "name", name))
    }
    let sent: u32 = alert.test(name, "Test alert from the RoboHub keeper")
    if sent == 0 {
        return plugins_page_message(req, keeper_t1(req, "plugins.test_not_delivered", "name", name))
    }
    info("keeper", "sent a test alert through " + name)
    if htmx_is_request(req) {
        return html(status_ok(), channel_row_html(req, name))
    }
    return plugins_page_message(req, keeper_t1(req, "plugins.test_handed", "name", name))
}

fn plugin_source_name(source: string) string {
    var tail: string = source
    let slash: i32 = rho_str_index_of(tail, "/")
    if slash >= 0 {
        var rest: string = tail
        var last: string = ""
        while rest != "" {
            let at: i32 = rho_str_index_of(rest, "/")
            if at < 0 {
                last = rest
                rest = ""
            } else {
                last = rho_str_slice(rest, 0, u32(at))
                rest = rho_str_slice(rest, u32(at) + 1,
                    u32(rho_strlen(rest)) - u32(at) - 1)
            }
        }
        tail = last
    }
    let suffix: i32 = rho_str_index_of(tail, ".git")
    if suffix >= 0 && u32(suffix) + 4 == u32(rho_strlen(tail)) {
        tail = rho_str_slice(tail, 0, u32(suffix))
    }
    return slug(tail)
}

fn plugins_install(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    if !forms_csrf_ok(body) {
        return html(status_forbidden(), "<p>" + i18n_t(req, "plugins.csrf_nothing_installed") + "</p>")
    }
    var name: string = str_trim(form_field(body, "name"))
    let source: string = str_trim(form_field(body, "source"))
    if source == "" {
        return plugins_page_message(req, i18n_t(req, "plugins.name_one"))
    }
    if name == "" {
        name = plugin_source_name(source)
    }
    if !valid_name(name) {
        return plugins_page_message(req, i18n_t(req, "plugins.bad_name"))
    }
    let target: string = plugin_root() + "/" + name
    if rho_path_exists(target) {
        return plugins_page_message(req, keeper_t1(req, "plugins.already_installed", "name", name))
    }
    ignore_u32(rho_exec_args("mkdir", "-p\n" + plugin_root() + "\n", apps_report("mkdir-plugins")))
    var code: u32 = 0
    if source_is_git(source) {
        code = rho_exec_args("git", "clone\n--\n" + source + "\n" + target + "\n",
            apps_report("install-plugin-" + name))
    } else {
        let path: string = resolve_path(source)
        if !rho_path_exists(path + "/module.yml") {
            return plugins_page_message(req, keeper_t1(req, "plugins.no_manifest", "path", path))
        }
        code = rho_exec_args("cp", "-r\n" + path + "\n" + target + "\n",
            apps_report("install-plugin-" + name))
    }
    if code != 0 {
        return plugins_page_message(req, keeper_t1(req, "plugins.could_not_install", "source", source))
    }
    // A plugin says what kind it is: `module.plugin_kind`, as every plugin here
    // is written, or a `plugin:` block.
    if plugin_field(target + "/module.yml", "kind") == "" {
        ignore_u32(rho_exec_args("rm", "-rf\n" + target + "\n", apps_report("remove-not-plugin")))
        return plugins_page_message(req, keeper_t1(req, "plugins.not_a_plugin", "source", source))
    }
    ignore_bool(plugin_db_add(plugin_root(), name))
    info("keeper", "installed plugin " + name)
    return plugins_page_message(req, keeper_t1(req, "plugins.installed_disabled", "name", name))
}

fn plugins_uninstall(req: Request) Response {
    if !keeper_allowed(req, "admin") {
        return keeper_refused(req)
    }
    let body: string = request_body(req)
    let name: string = str_trim(form_field(body, "name"))
    if !valid_name(name) || !rho_path_exists(plugin_manifest(plugin_root(), name)) {
        return plugins_page_message(req, keeper_t1(req, "plugins.no_such", "name", name))
    }
    let target: string = plugin_root() + "/" + name
    ignore_bool(plugin_db_remove(plugin_root(), name))
    ignore_u32(rho_exec_args("rm", "-rf\n" + target + "\n", apps_report("uninstall-plugin-" + name)))
    info("keeper", "uninstalled plugin " + name)
    if htmx_is_request(req) {
        return html(status_ok(), "")
    }
    return plugins_page_message(req, keeper_t1(req, "plugins.uninstalled", "name", name))
}
